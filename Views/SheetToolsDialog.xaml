<Window x:Class="ExcelSupport.Views.SheetToolsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ExcelSupport.Helpers"
        Title="{loc:Loc SheetTools_WindowTitle}" 
        Height="480" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Hàng 0: Header Workbook Info -->
            <RowDefinition Height="Auto"/>
            <!-- Hàng 1: Tab Control công cụ -->
            <RowDefinition Height="*"/>
            <!-- Hàng 2: Nút Đóng -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Loc SheetTools_HeaderTitle}" FontWeight="Bold" FontSize="12" Foreground="#1E3A8A"/>
                    <TextBlock x:Name="TxtWorkbookTitle" Text="Workbook" FontSize="11" Foreground="#3B82F6" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" x:Name="MainTabControl" Margin="0,0,0,10">

            <!-- ==================== TAB 1: TÁCH SHEETS ==================== -->
            <TabItem Header="{loc:Loc SheetTools_TabSplit}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Loc SheetTools_SplitDesc}" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <!-- Danh sách chọn sheet -->
                    <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="{loc:Loc SheetTools_BtnSelectAll}" Click="OnSplitSelectAllClick" Padding="6,2" Margin="0,0,6,0" Cursor="Hand"/>
                                <Button Content="{loc:Loc SheetTools_BtnUnselectAll}" Click="OnSplitUnselectAllClick" Padding="6,2" Cursor="Hand"/>
                            </StackPanel>
                            <ListBox Grid.Row="1" x:Name="LstSplitSheets" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding SheetName}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="2,3"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Thư mục lưu file -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Loc SheetTools_SaveFolderLabel}" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtSplitOutputFolder" Padding="5,3" FontSize="11.5" IsReadOnly="True"/>
                            <Button Grid.Column="2" Content="{loc:Loc SheetTools_BtnBrowseFolder}" Click="OnBrowseSplitFolderClick" Padding="8,4" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>

                    <!-- Tùy chọn giữ nguyên sheet gốc -->
                    <CheckBox Grid.Row="3" x:Name="ChkKeepOriginalSheets" 
                              Content="{loc:Loc SheetTools_ChkKeepOriginal}" 
                              IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <!-- Nút Thực hiện Tách -->
                    <Button Grid.Row="4" Content="{loc:Loc SheetTools_BtnExecuteSplit}" 
                            Background="#107C41" Foreground="#FFFFFF" FontWeight="Bold" 
                            Padding="12,7" Height="32" Click="OnExecuteSplitClick" Cursor="Hand"/>
                </Grid>
            </TabItem>

            <!-- ==================== TAB 2: GỘP DỮ LIỆU SHEETS ==================== -->
            <TabItem Header="{loc:Loc SheetTools_TabMerge}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Loc SheetTools_MergeDesc}" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <!-- Danh sách chọn sheet -->
                    <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="{loc:Loc SheetTools_BtnSelectAll}" Click="OnMergeSelectAllClick" Padding="6,2" Margin="0,0,6,0" Cursor="Hand"/>
                                <Button Content="{loc:Loc SheetTools_BtnUnselectAll}" Click="OnMergeUnselectAllClick" Padding="6,2" Cursor="Hand"/>
                            </StackPanel>
                            <ListBox Grid.Row="1" x:Name="LstMergeSheets" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding SheetName}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="2,3"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Tùy chọn tiêu đề -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <RadioButton x:Name="RadMergeAll" GroupName="MergeHeaderGroup"
                                     Content="{loc:Loc SheetTools_RadMergeAll}" 
                                     IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <RadioButton x:Name="RadMergeSkipSubHeaders" GroupName="MergeHeaderGroup"
                                     Content="{loc:Loc SheetTools_RadMergeSkipSubHeaders}" 
                                     FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Nút Thực hiện Gộp -->
                    <Button Grid.Row="3" Content="{loc:Loc SheetTools_BtnExecuteMerge}" 
                            Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" 
                            Padding="12,7" Height="32" Click="OnExecuteMergeClick" Cursor="Hand"/>
                </Grid>
            </TabItem>

            <!-- ==================== TAB 3: NHẬP TỪ FILE ==================== -->
            <TabItem Header="{loc:Loc SheetTools_TabImport}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Loc SheetTools_ImportDesc}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Button Content="{loc:Loc SheetTools_BtnBrowseFiles}" Click="OnBrowseImportFilesClick" 
                                Width="220" HorizontalAlignment="Left" Padding="8,4" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Danh sách file đã chọn -->
                    <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,8">
                        <ListBox x:Name="LstImportFiles" BorderThickness="0"/>
                    </Border>

                    <!-- Nút Thực hiện Nhập -->
                    <Button Grid.Row="2" Content="{loc:Loc SheetTools_BtnExecuteImport}" 
                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" 
                            Padding="12,7" Height="32" Click="OnExecuteImportClick" Cursor="Hand"/>
                </Grid>
            </TabItem>

            <!-- ==================== TAB 4: ĐỔI TÊN HÀNG LOẠT ==================== -->
            <TabItem Header="{loc:Loc SheetTools_TabBatchRename}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="{loc:Loc SheetTools_RenameRulesDesc}" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <!-- Tiền tố -->
                        <TextBlock Text="{loc:Loc SheetTools_PrefixLabel}" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtPrefix" Padding="6,4" Margin="0,0,0,8"/>

                        <!-- Hậu tố -->
                        <TextBlock Text="{loc:Loc SheetTools_SuffixLabel}" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtSuffix" Padding="6,4" Margin="0,0,0,8"/>

                        <!-- Tìm & Thay thế -->
                        <TextBlock Text="{loc:Loc SheetTools_FindTextLabel}" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtFindText" Padding="6,4" Margin="0,0,0,8"/>

                        <TextBlock Text="{loc:Loc SheetTools_ReplaceTextLabel}" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtReplaceText" Padding="6,4" Margin="0,0,0,14"/>

                        <!-- Nút Thực hiện -->
                        <Button Content="{loc:Loc SheetTools_BtnExecuteRename}" 
                                Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" 
                                Padding="12,7" Height="32" Click="OnExecuteBatchRenameClick" Cursor="Hand"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Nút Đóng -->
        <Button Grid.Row="2" Content="{loc:Loc Common_Close}" Width="80" Height="28" 
                HorizontalAlignment="Right" Click="OnCloseClick" Cursor="Hand"/>
    </Grid>
</Window>

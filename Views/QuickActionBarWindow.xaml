<Window x:Class="ExcelSupport.Views.QuickActionBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ExcelSupport.Helpers"
        Title="{loc:Loc QuickActionBar_Title}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontSize="12"
        Focusable="False"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Mini Action Button Style (Focusable=False to preserve Excel focus) -->
        <Style x:Key="FloatingActionBtnStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Spec Doc Button Style -->
        <Style x:Key="SpecDocBtnStyle" TargetType="Button" BasedOn="{StaticResource FloatingActionBtnStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <!-- Vertical Separator Style -->
        <Style x:Key="FloatingSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Fill" Value="#334155"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Outer Container Border with Shadow & Drag Grip -->
    <Border x:Name="OuterBorder" Margin="8" CornerRadius="18" BorderThickness="1.2" Padding="6,3"
            MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
        <Border.Style>
            <Style TargetType="Border">
                <!-- Dark Theme (Default) -->
                <Setter Property="Background" Value="#0F172A"/>
                <Setter Property="BorderBrush" Value="#38BDF8"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.45"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- Light Theme Trigger -->
                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="BorderBrush" Value="#94A3B8"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.22"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid VerticalAlignment="Center">
            <!-- Normal Actions Bar -->
            <StackPanel x:Name="ActionsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 0. Drag Grip -->
                <Border Background="Transparent" Cursor="SizeAll" Padding="2,0,4,0" VerticalAlignment="Center"
                        MouseLeftButtonDown="OnDragGripMouseDown">
                    <TextBlock Text="⋮⋮" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                </Border>

                <!-- 1. Copy Visible Only -->
                <Button Style="{StaticResource FloatingActionBtnStyle}"
                        ToolTip="{loc:Loc QuickActionBar_CopyVisible_Tip}"
                        Click="OnCopyVisibleClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📋" FontSize="13" VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <TextBlock Text="{loc:Loc QuickActionBar_CopyVisible}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 2. Zenkaku / Hankaku Converter -->
                <Button Style="{StaticResource FloatingActionBtnStyle}"
                        ToolTip="{loc:Loc QuickActionBar_Zenkaku_Tip}"
                        Click="OnZenkakuHankakuClick"
                        MouseRightButtonUp="OnZenkakuRightClick">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Loc QuickActionBar_ToHankaku}" Click="OnToHankakuMenuItemClick"/>
                            <MenuItem Header="{loc:Loc QuickActionBar_ToZenkaku}" Click="OnToZenkakuMenuItemClick"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔤" FontSize="13" VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <TextBlock Text="{loc:Loc QuickActionBar_Zenkaku}" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 3. AI Quick Translate -->
                <Button Style="{StaticResource FloatingActionBtnStyle}"
                        ToolTip="{loc:Loc QuickActionBar_AiTranslate_Tip}"
                        Click="OnAiTranslateClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌐" FontSize="13" VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <TextBlock Text="{loc:Loc QuickActionBar_AiTranslate}" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 4. Export Markdown Table -->
                <Button Style="{StaticResource FloatingActionBtnStyle}"
                        ToolTip="{loc:Loc QuickActionBar_ExportMarkdown_Tip}"
                        Click="OnExportMarkdownClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📑" FontSize="13" VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <TextBlock Text="{loc:Loc QuickActionBar_ExportMarkdown}" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 5. Trim Spaces -->
                <Button Style="{StaticResource FloatingActionBtnStyle}"
                        ToolTip="{loc:Loc QuickActionBar_TrimSpaces_Tip}"
                        Click="OnTrimSpacesClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✂️" FontSize="13" VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <TextBlock Text="{loc:Loc QuickActionBar_TrimSpaces}" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Separator -->
                <Rectangle Style="{StaticResource FloatingSeparator}"/>

                <!-- 6. Project Spec Launcher Group (TKCT, TKCB, UT) -->
                <!-- TKCT (Detailed Design) -->
                <Button Style="{StaticResource SpecDocBtnStyle}"
                        ToolTip="{loc:Loc QuickActionBar_DocTkct_Tip}"
                        Click="OnDocTkctClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📐" FontSize="11" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        <TextBlock Text="TKCT" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- TKCB (Basic Design) -->
                <Button Style="{StaticResource SpecDocBtnStyle}"
                        ToolTip="{loc:Loc QuickActionBar_DocTkcb_Tip}"
                        Click="OnDocTkcbClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📘" FontSize="11" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        <TextBlock Text="TKCB" Foreground="#A78BFA" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- UT / Test Spec -->
                <Button Style="{StaticResource SpecDocBtnStyle}"
                        ToolTip="{loc:Loc QuickActionBar_DocUt_Tip}"
                        Click="OnDocUtClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧪" FontSize="11" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        <TextBlock Text="UT" Foreground="#4ADE80" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Separator -->
                <Rectangle Style="{StaticResource FloatingSeparator}"/>

                <!-- 7. Dismiss / Close Button -->
                <Button Style="{StaticResource FloatingActionBtnStyle}"
                        Padding="4,2"
                        Margin="2,0,0,0"
                        ToolTip="{loc:Loc QuickActionBar_Close_Tip}"
                        Click="OnDismissClick">
                    <TextBlock Text="✕" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

            <!-- Feedback Toast Notification Bar (Overlay when action executes) -->
            <Border x:Name="ToastFeedbackBorder" Background="#047857" CornerRadius="12" Padding="12,4"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtToastIcon" Text="✓" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtToastMessage" Text="Thành công!" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

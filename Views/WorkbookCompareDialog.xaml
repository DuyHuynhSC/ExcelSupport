<Window x:Class="ExcelSupport.Views.WorkbookCompareDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExcelSupport.Views"
        xmlns:loc="clr-namespace:ExcelSupport.Helpers"
        mc:Ignorable="d"
        Title="{loc:Loc Comp_WindowTitle}" 
        Height="740" Width="1080"
        MinHeight="580" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Custom ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Standard Button Styles -->
        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F1F5F9"/>
                    <Setter Property="BorderBrush" Value="#334155"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Dark Theme aware RadioButton Style -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#E2E8F0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Dark Theme aware CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#E2E8F0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Source & Config Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Filter & Stats Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 3: DataGrid Results -->
            <RowDefinition Height="*"/>
            <!-- 4: Footer / Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 0. HEADER ==================== -->
        <Border Grid.Row="0" Padding="20,12" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Comp_Title}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{loc:Loc Comp_SubTitle}" 
                               FontSize="11.5" Margin="26,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Statistics Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="BadgeModified" CornerRadius="10" Padding="10,4" Margin="0,0,6,0" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1">
                        <TextBlock x:Name="TxtCountModified" Text="0" FontWeight="SemiBold" FontSize="11" Foreground="#92400E"/>
                    </Border>
                    <Border x:Name="BadgeAdded" CornerRadius="10" Padding="10,4" Margin="0,0,6,0" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1">
                        <TextBlock x:Name="TxtCountAdded" Text="0" FontWeight="SemiBold" FontSize="11" Foreground="#166534"/>
                    </Border>
                    <Border x:Name="BadgeDeleted" CornerRadius="10" Padding="10,4" Margin="0,0,0,0" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1">
                        <TextBlock x:Name="TxtCountDeleted" Text="0" FontWeight="SemiBold" FontSize="11" Foreground="#991B1B"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 1. SOURCE & CONFIG BAR ==================== -->
        <Border Grid.Row="1" Padding="20,12" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="BorderBrush" Value="#1E293B"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Dòng 1: Chọn Workbook A và Workbook B -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Nguồn A (File Gốc) -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc Comp_FileA}" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Foreground" Value="#CBD5E1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CboWorkbook1" Grid.Column="0" Height="28" Margin="0,0,6,0" SelectionChanged="OnWorkbook1SelectionChanged"/>
                            <ComboBox x:Name="CboSheet1" Grid.Column="1" Height="28"/>
                        </Grid>
                    </StackPanel>

                    <!-- Biểu tượng so sánh ⇋ -->
                    <TextBlock Grid.Column="1" Text="⇋" FontSize="20" FontWeight="Bold" Foreground="#94A3B8" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16,0,0"/>

                    <!-- Nguồn B (File Mới) -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:Loc Comp_FileB}" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Foreground" Value="#CBD5E1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CboWorkbook2" Grid.Column="0" Height="28" Margin="0,0,6,0" SelectionChanged="OnWorkbook2SelectionChanged"/>
                            <ComboBox x:Name="CboSheet2" Grid.Column="1" Height="28"/>
                        </Grid>
                    </StackPanel>

                    <!-- Nút Quét So Sánh -->
                    <Button Grid.Column="3" Content="{loc:Loc Comp_BtnCompareNow}" Height="28" Margin="14,18,0,0" 
                            Style="{StaticResource DialogPrimaryButtonStyle}" Click="OnCompareClick"/>
                </Grid>

                <!-- Dòng 2: Thuật toán so sánh (LCS / Tọa độ / Cột Khóa) -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Comp_AlgoHeader}" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#475569"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <RadioButton x:Name="RbLcsRows" Content="{loc:Loc Comp_LcsRows}" IsChecked="True" GroupName="CompMode" Margin="0,0,12,0"/>
                    <RadioButton x:Name="RbLcsCols" Content="{loc:Loc Comp_LcsCols}" GroupName="CompMode" Margin="0,0,12,0"/>
                    <RadioButton x:Name="RbLcs2D" Content="{loc:Loc Comp_Lcs2D}" GroupName="CompMode" Margin="0,0,12,0"/>
                    <RadioButton x:Name="RbCellByCell" Content="{loc:Loc Comp_CellByCell}" GroupName="CompMode" Margin="0,0,12,0"/>
                    <RadioButton x:Name="RbKeyColumn" Content="{loc:Loc Comp_KeyColumn}" GroupName="CompMode" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CboKeyColumn" Width="95" Height="24" Margin="0,0,8,0" FontSize="11"/>
                </WrapPanel>

                <!-- Dòng 3: Tùy chọn lọc chuỗi so sánh -->
                <WrapPanel Grid.Row="2" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Comp_OptionsHeader}" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#475569"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <CheckBox x:Name="ChkIgnoreWhitespace" Content="{loc:Loc Comp_IgnoreWhitespace}" IsChecked="True" Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkCaseInsensitive" Content="{loc:Loc Comp_IgnoreCase}" Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkCompareFormulas" Content="{loc:Loc Comp_CompareFormulas}" Margin="0,0,0,0"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. FILTER & SEARCH BAR ==================== -->
        <Border Grid.Row="2" Padding="20,8" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#F1F5F9"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <!-- Bộ lọc theo loại sai khác -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Comp_FilterHeader}" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#334155"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <RadioButton x:Name="RbFilterAll" Content="{loc:Loc Comp_FilterAll}" IsChecked="True" GroupName="DiffFilter" Margin="0,0,10,0" Checked="OnDiffFilterChanged"/>
                    <RadioButton x:Name="RbFilterModified" Content="{loc:Loc Comp_FilterModified}" GroupName="DiffFilter" Margin="0,0,10,0" Checked="OnDiffFilterChanged"/>
                    <RadioButton x:Name="RbFilterAdded" Content="{loc:Loc Comp_FilterAdded}" GroupName="DiffFilter" Margin="0,0,10,0" Checked="OnDiffFilterChanged"/>
                    <RadioButton x:Name="RbFilterDeleted" Content="{loc:Loc Comp_FilterDeleted}" GroupName="DiffFilter" Margin="0,0,0,0" Checked="OnDiffFilterChanged"/>
                </StackPanel>

                <!-- Ô tìm kiếm -->
                <Border Grid.Column="2" CornerRadius="6" BorderThickness="1" Height="28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Background" Value="#0F172A"/>
                                    <Setter Property="BorderBrush" Value="#475569"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Margin="8,0,4,0" VerticalAlignment="Center" Foreground="#94A3B8"/>
                        <TextBox Grid.Column="1" x:Name="TxtSearch" BorderThickness="0" Background="Transparent" 
                                 VerticalContentAlignment="Center" FontSize="11.5"
                                 TextChanged="OnSearchTextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Setter Property="CaretBrush" Value="#0F172A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                            <Setter Property="CaretBrush" Value="#F8FAFC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="2" Content="✕" FontSize="10" Margin="0,0,6,0" Background="Transparent" 
                                BorderThickness="0" Foreground="#94A3B8" Cursor="Hand" Click="OnClearSearchClick"
                                Visibility="{Binding Text.Length, ElementName=TxtSearch, Converter={StaticResource BoolToVisConverter}}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 3. RESULTS DATAGRID ==================== -->
        <DataGrid Grid.Row="3" x:Name="GridDiffResults" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="OnRowDoubleClick"
                  BorderThickness="0">
            <DataGrid.Style>
                <Style TargetType="DataGrid">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                    <Setter Property="RowBackground" Value="#FFFFFF"/>
                    <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
                    <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="Foreground" Value="#F8FAFC"/>
                            <Setter Property="RowBackground" Value="#0F172A"/>
                            <Setter Property="AlternatingRowBackground" Value="#1E293B"/>
                            <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="Foreground" Value="#475569"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <!-- STT -->
                <DataGridTextColumn Header="{loc:Loc Comp_ColSTT}" Binding="{Binding Index}" Width="55">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Tên Sheet -->
                <DataGridTextColumn Header="{loc:Loc Comp_ColSheet}" Binding="{Binding SheetName}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,0"/>
                            <Setter Property="Foreground" Value="#0F172A"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Foreground" Value="#F1F5F9"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Vị trí / Khóa -->
                <DataGridTextColumn Header="{loc:Loc Comp_ColKey}" Binding="{Binding KeyIdentifier}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="#3B82F6"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Loại Sai Khác (Badge) -->
                <DataGridTemplateColumn Header="{loc:Loc Comp_ColDiffType}" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Modified">
                                                <Setter Property="Background" Value="#FEF3C7"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Added">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Deleted">
                                                <Setter Property="Background" Value="#FEE2E2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding TypeDescription}" FontWeight="SemiBold" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Modified">
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Added">
                                                    <Setter Property="Foreground" Value="#166534"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Deleted">
                                                    <Setter Property="Foreground" Value="#991B1B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Giá trị File A (Gốc) có tô đỏ phần khác biệt -->
                <DataGridTemplateColumn Header="{loc:Loc Comp_ColValA}" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock local:InlineDiffHelper.DiffSegments="{Binding OldValueSegments}"
                                       VerticalAlignment="Center" Padding="6,0" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Giá trị File B (Mới) có tô đỏ phần khác biệt (ví dụ số 1) -->
                <DataGridTemplateColumn Header="{loc:Loc Comp_ColValB}" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock local:InlineDiffHelper.DiffSegments="{Binding NewValueSegments}"
                                       VerticalAlignment="Center" Padding="6,0" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Cột Hành Động (Đi tới ô) -->
                <DataGridTemplateColumn Header="{loc:Loc Comp_ColAction}" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{loc:Loc Comp_BtnGoTo}" FontSize="10.5" Padding="6,3" Cursor="Hand"
                                     Style="{StaticResource DialogActionButtonStyle}"
                                     Click="OnGoToCellClick"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ==================== 4. FOOTER & ACTIONS ==================== -->
        <Border Grid.Row="4" Padding="20,12" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Message -->
                <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="{loc:Loc Common_Ready}" 
                           VerticalAlignment="Center" FontSize="11.5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Comp_BtnHighlight}" Margin="0,0,8,0"
                            Style="{StaticResource DialogActionButtonStyle}"
                            Click="OnHighlightClick"/>

                    <Button Content="{loc:Loc Comp_BtnReportSheet}" Margin="0,0,8,0"
                            Style="{StaticResource DialogActionButtonStyle}"
                            Click="OnCreateReportSheetClick"/>

                    <Button Content="{loc:Loc Comp_BtnExportCsv}" Margin="0,0,8,0"
                            Style="{StaticResource DialogActionButtonStyle}"
                            Click="OnExportCsvClick"/>

                    <Button Content="{loc:Loc Common_Close}" Width="70"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            Click="OnCloseClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

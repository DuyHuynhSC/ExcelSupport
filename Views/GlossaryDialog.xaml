<Window x:Class="ExcelSupport.Views.GlossaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ExcelSupport.Models"
        Title="Quản Lý Thuật Ngữ Chuyên Ngành (Glossary)" 
        Height="560" Width="860" 
        MinHeight="420" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Style DataGrid Header -->
        <Style x:Key="GlossaryHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F1F5F9"/>
                    <Setter Property="BorderBrush" Value="#334155"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style DataGrid Cell -->
        <Style x:Key="GlossaryCellStyle" TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#1E3A8A"/>
                    <Setter Property="Foreground" Value="#93C5FD"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style DataGrid Row -->
        <Style x:Key="GlossaryRowStyle" TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Style Default TextBox for editing in DataGrid -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="CaretBrush" Value="#0F172A"/>
            <Setter Property="SelectionBrush" Value="#3B82F6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                    <Setter Property="CaretBrush" Value="#F8FAFC"/>
                    <Setter Property="Background" Value="#1E293B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Toolbar & Search -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Footer & Actions -->
        </Grid.RowDefinitions>

        <!-- ==================== 1. HEADER ==================== -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="16,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📖 " FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Từ Điển Thuật Ngữ Chuyên Ngành (Glossary)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Định nghĩa các cặp từ vựng Nhật ⇋ Việt để AI bắt buộc sử dụng khi dịch bảng tính Excel." 
                               FontSize="11" Margin="0,3,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Badge Đếm Số Lượng -->
                <Border Grid.Column="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#DCFCE7"/>
                            <Setter Property="BorderBrush" Value="#86EFAC"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Background" Value="#064E3B"/>
                                    <Setter Property="BorderBrush" Value="#059669"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="TxtTotalCount" Text="0 thuật ngữ" FontWeight="Bold" FontSize="11.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#166534"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="#6EE7B7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 2. TOOLBAR & SEARCH ==================== -->
        <Border Grid.Row="1" Padding="16,8" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#F1F5F9"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ô tìm kiếm -->
                <Border Grid.Column="0" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,10,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Background" Value="#0F172A"/>
                                    <Setter Property="BorderBrush" Value="#475569"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="TxtSearch" BorderThickness="0" Background="Transparent" 
                                 VerticalAlignment="Center" FontSize="11.5" TextChanged="OnSearchTextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Setter Property="CaretBrush" Value="#0F172A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                            <Setter Property="CaretBrush" Value="#F8FAFC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Các nút Thao tác -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="➕ Thêm Thuật Ngữ" Click="OnAddRowClick" Padding="10,5" Margin="0,0,6,0" Cursor="Hand" FontWeight="SemiBold" Background="#107C41" Foreground="#FFFFFF"/>
                    <Button Content="📥 Import (CSV/JSON)" Click="OnImportClick" Padding="10,5" Margin="0,0,6,0" Cursor="Hand" FontWeight="SemiBold" Background="#2563EB" Foreground="#FFFFFF"/>
                    <Button Content="📤 Export (CSV/JSON)" Click="OnExportClick" Padding="10,5" Margin="0,0,6,0" Cursor="Hand" FontWeight="SemiBold"/>
                    <Button Content="🗑️ Xóa Hết" Click="OnClearAllClick" Padding="10,5" Cursor="Hand" FontWeight="SemiBold" Foreground="#DC2626"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 3. DATAGRID BẢNG TỪ ĐIỂN ==================== -->
        <DataGrid Grid.Row="2" x:Name="GridGlossary" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  CanUserDeleteRows="True"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  ColumnHeaderStyle="{StaticResource GlossaryHeaderStyle}"
                  CellStyle="{StaticResource GlossaryCellStyle}"
                  RowStyle="{StaticResource GlossaryRowStyle}"
                  RowHeight="28"
                  BorderThickness="0"
                  Margin="16,10,16,6">
            <DataGrid.Style>
                <Style TargetType="DataGrid">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>
            <DataGrid.Columns>
                <!-- Cột 1: Tiếng Nhật -->
                <DataGridTextColumn Header="🇯🇵 Tiếng Nhật (Japanese)" Binding="{Binding Japanese, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*" FontWeight="SemiBold"/>

                <!-- Cột 2: Tiếng Việt -->
                <DataGridTextColumn Header="🇻🇳 Tiếng Việt (Vietnamese)" Binding="{Binding Vietnamese, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*" FontWeight="SemiBold"/>

                <!-- Cột 3: Ghi chú -->
                <DataGridTextColumn Header="📝 Ghi Chú Ngữ Cảnh" Binding="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/>

                <!-- Cột 4: Nút Xóa dòng -->
                <DataGridTemplateColumn Header="Thao Tác" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🗑️ Xóa" Click="OnDeleteRowClick" 
                                    Padding="4,1" FontSize="10.5" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Foreground="#DC2626"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ==================== 4. FOOTER & ACTIONS ==================== -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" Padding="16,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Thông báo trạng thái -->
                <TextBlock Grid.Column="0" x:Name="TxtStatus" Text="Nhập trực tiếp vào bảng hoặc bấm Import từ file CSV / JSON." 
                           FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>

                <!-- Nút Lưu & Đóng -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="💾 Lưu &amp; Áp Dụng" Click="OnSaveAndCloseClick" 
                            Background="#107C41" Foreground="#FFFFFF" FontWeight="Bold" 
                            Padding="14,6" Height="30" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="Hủy" Click="OnCancelClick" 
                            Padding="12,6" Height="30" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

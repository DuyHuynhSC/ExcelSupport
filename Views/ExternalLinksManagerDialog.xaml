<Window x:Class="ExcelSupport.Views.ExternalLinksManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ExcelSupport.Helpers"
        Title="{loc:Loc Links_WindowTitle}"
        Height="680" Width="1000"
        MinHeight="520" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <!-- Primary Action Button (Green) -->
        <Style x:Key="ExtPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#107C41"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0A552A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#063C1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button (Red / Break Link) -->
        <Style x:Key="ExtDangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button (Gray / Outline) -->
        <Style x:Key="ExtSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Header Style -->
        <Style x:Key="ExtHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F1F5F9"/>
                    <Setter Property="BorderBrush" Value="#334155"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Row Style -->
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Cell Style -->
        <Style x:Key="ExtCellStyle" TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#2563EB"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#60A5FA"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Stat Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Body Tabs -->
            <RowDefinition Height="*"/>
            <!-- Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 1. HEADER ==================== -->
        <Border Grid.Row="0" Padding="20,12" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔗" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Links_Title}" FontWeight="Bold" FontSize="15">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{loc:Loc Links_SubTitle}" 
                               FontSize="11.5" Foreground="#64748B" Margin="30,2,0,0"/>
                </StackPanel>

                <!-- Action Quét lại -->
                <Button Grid.Column="1" Content="{loc:Loc Links_BtnRescan}" Style="{StaticResource ExtSecondaryBtn}" 
                        VerticalAlignment="Center" Click="OnRefreshClick"/>
            </Grid>
        </Border>

        <!-- ==================== 2. STAT CARDS ==================== -->
        <Grid Grid.Row="1" Margin="20,10,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Tổng file nguồn ngoài -->
            <Border Grid.Column="0" Margin="0,0,6,0" Padding="12,8" CornerRadius="8" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Links_CardSources}" FontSize="11" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtStatSources" Text="0" FontSize="16" FontWeight="Bold" Foreground="#0284C7" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: File hỏng / Không tồn tại -->
            <Border Grid.Column="1" Margin="3,0,3,0" Padding="12,8" CornerRadius="8" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FEF2F2"/>
                        <Setter Property="BorderBrush" Value="#FECACA"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="#450A0A"/>
                                <Setter Property="BorderBrush" Value="#7F1D1D"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Links_CardBroken}" FontSize="11" Foreground="#DC2626"/>
                    <TextBlock x:Name="TxtStatBroken" Text="0" FontSize="16" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Số ô công thức -->
            <Border Grid.Column="2" Margin="3,0,3,0" Padding="12,8" CornerRadius="8" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FFFBEB"/>
                        <Setter Property="BorderBrush" Value="#FDE68A"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="#451A03"/>
                                <Setter Property="BorderBrush" Value="#78350F"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Links_CardCells}" FontSize="11" Foreground="#D97706"/>
                    <TextBlock x:Name="TxtStatCells" Text="0" FontSize="16" FontWeight="Bold" Foreground="#D97706" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Named Ranges -->
            <Border Grid.Column="3" Margin="6,0,0,0" Padding="12,8" CornerRadius="8" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Links_CardNames}" FontSize="11" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtStatNames" Text="0" FontSize="16" FontWeight="Bold" Foreground="#6366F1" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 3. BODY TABS ==================== -->
        <TabControl Grid.Row="2" Margin="20,10,20,10" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: DANH SÁCH FILE LIÊN KẾT -->
            <TabItem Header="{loc:Loc Links_TabSources}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="GridSources" Grid.Row="0"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              ColumnHeaderStyle="{StaticResource ExtHeaderStyle}"
                              CellStyle="{StaticResource ExtCellStyle}"
                              SelectionMode="Single" BorderThickness="1">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="RowBackground" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="RowBackground" Value="#1E293B"/>
                                        <Setter Property="BorderBrush" Value="#334155"/>
                                        <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>

                        <DataGrid.Columns>
                            <!-- Tên file -->
                            <DataGridTextColumn Header="{loc:Loc Links_ColFileName}" Binding="{Binding FileName}" Width="200" IsReadOnly="True" FontWeight="Bold"/>
                            
                            <!-- Đường dẫn -->
                            <DataGridTextColumn Header="{loc:Loc Links_ColFullPath}" Binding="{Binding SourcePath}" Width="*" IsReadOnly="True"/>
                            
                            <!-- Trạng thái -->
                            <DataGridTemplateColumn Header="{loc:Loc Links_ColStatus}" Width="200" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusDisplay}" FontWeight="SemiBold" FontSize="11.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Exists}" Value="False">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Số ô tham chiếu -->
                            <DataGridTextColumn Header="{loc:Loc Links_ColFormulaCount}" Binding="{Binding FormulaCount}" Width="120" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Thao tác trên Source -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="{loc:Loc Links_BtnChangeLink}" Style="{StaticResource ExtSecondaryBtn}" Margin="0,0,10,0" Click="OnChangeLinkClick"/>
                        <Button Content="{loc:Loc Links_BtnBreakSelected}" Style="{StaticResource ExtDangerBtn}" Click="OnBreakSelectedSourceClick"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 2: CHI TIẾT Ô CÔNG THỨC -->
            <TabItem Header="{loc:Loc Links_TabCells}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <!-- Search & Quick Filter -->
                        <RowDefinition Height="Auto"/>
                        <!-- Grid -->
                        <RowDefinition Height="*"/>
                        <!-- Action Bar -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search -->
                        <TextBox x:Name="TxtSearchCells" Grid.Column="0" Height="28" VerticalContentAlignment="Center" Padding="8,0"
                                 TextChanged="OnCellSearchChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                            <Setter Property="BorderBrush" Value="#475569"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock IsHitTestVisible="False" Text="{loc:Loc Links_WatermarkSearch}" 
                                   VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11.5" Foreground="#94A3B8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearchCells}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Column="1" Text="{loc:Loc Links_TipDoubleClick}" 
                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11.5" Foreground="#64748B" Margin="0,0,10,0"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="{loc:Loc Common_SelectAll}" Style="{StaticResource ExtSecondaryBtn}" Padding="8,4" FontSize="11" Margin="0,0,4,0" Click="OnSelectAllCellsClick"/>
                            <Button Content="{loc:Loc Common_DeselectAll}" Style="{StaticResource ExtSecondaryBtn}" Padding="8,4" FontSize="11" Click="OnUnselectAllCellsClick"/>
                        </StackPanel>
                    </Grid>

                    <!-- DataGrid Cells -->
                    <DataGrid x:Name="GridFormulaCells" Grid.Row="1"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              ColumnHeaderStyle="{StaticResource ExtHeaderStyle}"
                              CellStyle="{StaticResource ExtCellStyle}"
                              SelectionMode="Single" BorderThickness="1"
                              MouseDoubleClick="OnGridCellDoubleClick">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="RowBackground" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="RowBackground" Value="#1E293B"/>
                                        <Setter Property="BorderBrush" Value="#334155"/>
                                        <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>

                        <DataGrid.Columns>
                            <!-- Checkbox chọn -->
                            <DataGridCheckBoxColumn Header="{loc:Loc Common_All}" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>

                            <!-- Sheet -->
                            <DataGridTextColumn Header="{loc:Loc VN_ColSheet}" Binding="{Binding SheetName}" Width="110" IsReadOnly="True" FontWeight="SemiBold"/>

                            <!-- Ô -->
                            <DataGridTextColumn Header="{loc:Loc VN_ColPosition}" Binding="{Binding CellAddress}" Width="75" IsReadOnly="True" FontWeight="Bold"/>

                            <!-- Công thức -->
                            <DataGridTextColumn Header="{loc:Loc Links_ColFormula}" Binding="{Binding Formula}" Width="3*" IsReadOnly="True"/>

                            <!-- Giá trị -->
                            <DataGridTextColumn Header="{loc:Loc Links_ColValue}" Binding="{Binding CurrentValue}" Width="120" IsReadOnly="True"/>

                            <!-- File Tham Chiếu -->
                            <DataGridTextColumn Header="{loc:Loc Links_ColFileName}" Binding="{Binding ExternalSource}" Width="150" IsReadOnly="True"/>

                            <!-- Trạng thái -->
                            <DataGridTemplateColumn Header="{loc:Loc Links_ColStatus}" Width="140" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontWeight="SemiBold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="⚠️ Link"/>
                                                    <Setter Property="Foreground" Value="#D97706"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                                            <Setter Property="Text" Value="❌ Broken / Missing"/>
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Thao tác trên Cells -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="{loc:Loc VN_BtnGoTo}" Style="{StaticResource ExtSecondaryBtn}" Margin="0,0,10,0" Click="OnGoToSelectedCellClick"/>
                        <Button Content="{loc:Loc Links_BtnFreezeValues}" Style="{StaticResource ExtPrimaryBtn}" Click="OnFreezeSelectedCellsClick"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 3: NAMED RANGES -->
            <TabItem Header="{loc:Loc Links_TabNames}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="GridNamedRanges" Grid.Row="0"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              ColumnHeaderStyle="{StaticResource ExtHeaderStyle}"
                              CellStyle="{StaticResource ExtCellStyle}"
                              SelectionMode="Single" BorderThickness="1">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="RowBackground" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="RowBackground" Value="#1E293B"/>
                                        <Setter Property="BorderBrush" Value="#334155"/>
                                        <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>

                        <DataGrid.Columns>
                            <!-- Checkbox -->
                            <DataGridCheckBoxColumn Header="{loc:Loc Common_All}" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>

                            <!-- Tên Name -->
                            <DataGridTextColumn Header="{loc:Loc Links_ColName}" Binding="{Binding Name}" Width="200" IsReadOnly="True" FontWeight="Bold"/>

                            <!-- Phạm vi -->
                            <DataGridTextColumn Header="{loc:Loc Links_ColScope}" Binding="{Binding Scope}" Width="100" IsReadOnly="True"/>

                            <!-- Tham chiếu -->
                            <DataGridTextColumn Header="{loc:Loc Links_ColRefersTo}" Binding="{Binding RefersTo}" Width="*" IsReadOnly="True"/>

                            <!-- Trạng thái -->
                            <DataGridTemplateColumn Header="{loc:Loc Links_ColStatus}" Width="140" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontWeight="SemiBold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="⚠️ Link"/>
                                                    <Setter Property="Foreground" Value="#D97706"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                                            <Setter Property="Text" Value="❌ #REF! / Broken"/>
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Thao tác trên Named Ranges -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="{loc:Loc Common_Delete}" Style="{StaticResource ExtDangerBtn}" Click="OnDeleteSelectedNamesClick"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ==================== 4. FOOTER ACTIONS ==================== -->
        <Border Grid.Row="3" Padding="20,12" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{loc:Loc Links_BtnHighlight}" Style="{StaticResource ExtSecondaryBtn}" Margin="0,0,8,0" Click="OnHighlightCellsClick"/>
                    <Button Content="{loc:Loc Links_BtnReportSheet}" Style="{StaticResource ExtSecondaryBtn}" Margin="0,0,8,0" Click="OnExportReportClick"/>
                </StackPanel>

                <!-- Right actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{loc:Loc Links_BtnBreakAll}" Style="{StaticResource ExtDangerBtn}" Margin="0,0,10,0" Click="OnBreakAllLinksClick"/>
                    <Button Content="{loc:Loc Common_Close}" Width="80" Style="{StaticResource ExtSecondaryBtn}" Click="OnCloseClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="ExcelSupport.Views.SpecVersionSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ExcelSupport.Helpers"
        Title="ExcelSupport - Version Selector"
        Width="750" Height="520"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        KeyDown="OnWindowKeyDown">

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Keycap Shortcut Badge -->
        <Style x:Key="KeycapBadge" TargetType="Border">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Latest Version Badge -->
        <Style x:Key="LatestBadge" TargetType="Border">
            <Setter Property="Background" Value="#FEF3C7"/>
            <Setter Property="BorderBrush" Value="#FCD34D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#78350F"/>
                    <Setter Property="BorderBrush" Value="#B45309"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                                <Setter Property="BorderBrush" Value="#475569"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc SpecLauncher_HeaderTitle}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Meta Badges: DocType, Keyword, Profile -->
                    <StackPanel Orientation="Horizontal" Margin="28,6,0,0">
                        <!-- Doc Type Badge -->
                        <Border x:Name="bdDocType" Background="#DBEAFE" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock x:Name="lblDocType" Text="TKCT" FontWeight="Bold" FontSize="11" Foreground="#1D4ED8"/>
                        </Border>

                        <!-- Keyword Badge -->
                        <Border Background="#E0E7FF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Mã: " FontSize="11" Foreground="#4338CA"/>
                                <TextBlock x:Name="lblKeyword" Text="SCR_001" FontWeight="Bold" FontSize="11" Foreground="#4338CA"/>
                            </StackPanel>
                        </Border>

                        <!-- Project Profile Badge -->
                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁 Dự án: " FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="lblProfileName" Text="Sakura ERP" FontWeight="SemiBold" FontSize="11" Foreground="#334155"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" VerticalAlignment="Top" 
                        Content="⚙️ Profile..." 
                        Style="{StaticResource SecondaryActionBtn}" 
                        Click="OnOpenSettingsClick"/>
            </Grid>
        </Border>

        <!-- Search / Filter Input -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtFilter" Grid.Column="0" 
                     Height="32" FontSize="13" VerticalContentAlignment="Center"
                     Padding="8,0" 
                     TextChanged="OnFilterTextChanged"
                     PreviewKeyDown="OnFilterPreviewKeyDown"/>

            <Button Grid.Column="1" Margin="8,0,0,0" Height="32"
                    Content="🔍 Quét lại" 
                    Style="{StaticResource SecondaryActionBtn}"
                    Click="OnRescanClick"/>
        </Grid>

        <!-- Result Candidates List -->
        <Border Grid.Row="2" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" 
                BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12">
            <ListBox x:Name="lstFiles" 
                     BorderThickness="0" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseDoubleClick="OnListMouseDoubleClick"
                     SelectionChanged="OnListSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6" Margin="2,1" CornerRadius="4" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Index Badge (1-9) -->
                                <Border Grid.Column="0" Style="{StaticResource KeycapBadge}" 
                                        VerticalAlignment="Center" Margin="0,0,10,0" Width="24" Height="24">
                                    <TextBlock Text="{Binding ItemIndex}" FontWeight="Bold" FontSize="12" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- File Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="13" 
                                                   TextTrimming="CharacterEllipsis"/>
                                        
                                        <!-- Latest Version Badge -->
                                        <Border Style="{StaticResource LatestBadge}" Margin="8,0,0,0"
                                                Visibility="{Binding IsLatest, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="⭐ MỚI NHẤT" FontWeight="Bold" FontSize="10" Foreground="#D97706"/>
                                        </Border>

                                        <!-- Detected Version Badge -->
                                        <Border Background="#F1F5F9" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding DetectedVersion}" FontSize="10" Foreground="#475569" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Relative Directory -->
                                    <TextBlock Text="{Binding RelativeDirectory}" FontSize="11" Foreground="#64748B" 
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Metadata: Modified Time & File Size -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,4,0">
                                    <TextBlock Text="{Binding LastModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" 
                                               FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding FormattedSize}" FontSize="11" FontWeight="SemiBold" 
                                               Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Bottom Controls & Hints -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Read-Only Checkbox -->
            <CheckBox x:Name="chkReadOnly" Grid.Column="0" 
                      VerticalAlignment="Center"
                      Content="Mở dạng chỉ đọc (Read-Only) để bảo vệ tài liệu gốc"/>

            <!-- Keyboard Hint -->
            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                       FontSize="11" Foreground="#94A3B8"
                       Text="[Enter] Mở | [1-9] Phím số chọn nhanh | [F5] Mở folder | [Esc] Đóng"/>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="📂 Mở Thư Mục" 
                        Style="{StaticResource SecondaryActionBtn}" 
                        Margin="0,0,8,0"
                        Click="OnOpenFolderClick"/>

                <Button Content="🚀 Mở Tài Liệu" 
                        Style="{StaticResource PrimaryActionBtn}" 
                        Click="OnOpenSelectedClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

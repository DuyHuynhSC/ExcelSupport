<Window x:Class="ExcelSupport.Views.AiQuickTranslatePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ExcelSupport.Helpers"
        Title="AI Quick Translate"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="500"
        MinHeight="160"
        MaxHeight="480"
        SizeToContent="Height"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <!-- Mini Button Style -->
        <Style x:Key="MiniBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Direction Radio Pill Style -->
        <Style x:Key="DirectionPillStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pillBorder" CornerRadius="4" Padding="6,2" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Outer Card Border with Shadow -->
    <Border Margin="10" CornerRadius="10" BorderThickness="1" Padding="0">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#0F172A" Opacity="0.28"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <!-- 0. Header (Draggable) -->
                <RowDefinition Height="Auto"/>
                <!-- 1. Body (Translated Content) -->
                <RowDefinition Height="*"/>
                <!-- 2. Original Text Snippet (Collapsible) -->
                <RowDefinition Height="Auto"/>
                <!-- 3. Footer (Action Buttons) -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==================== 0. HEADER ==================== -->
            <Border Grid.Row="0" CornerRadius="9,9,0,0" Padding="12,8" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Cell Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Dịch Nhanh AI" FontWeight="Bold" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border x:Name="BdCellBadge" CornerRadius="4" Padding="6,1" Background="#2563EB" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCellBadge" Text="A1" FontWeight="Bold" FontSize="10.5" Foreground="#FFFFFF"/>
                        </Border>
                    </StackPanel>

                    <!-- Direction Switcher -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
                        <RadioButton x:Name="RbJaVi" Content="JP ➔ VN" Style="{StaticResource DirectionPillStyle}" IsChecked="True" Checked="OnDirectionChanged"/>
                        <RadioButton x:Name="RbViJa" Content="VN ➔ JP" Style="{StaticResource DirectionPillStyle}" Checked="OnDirectionChanged"/>
                        <RadioButton x:Name="RbEnVi" Content="EN ➔ VN" Style="{StaticResource DirectionPillStyle}" Checked="OnDirectionChanged"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="✕" Style="{StaticResource MiniBtnStyle}" Width="24" Height="24" Padding="0" 
                                ToolTip="Đóng (Esc)" Click="OnCloseClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 1. TRANSLATED CONTENT BODY ==================== -->
            <Grid Grid.Row="1" MinHeight="70" Margin="14,10,14,6">
                <!-- Loading Shimmer / Spinner -->
                <StackPanel x:Name="PanelLoading" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible" Margin="0,12">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4" Foreground="#2563EB" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtLoadingStatus" Text="Đang dịch với AI..." FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Translation Result Display -->
                <ScrollViewer x:Name="SvTranslation" VerticalScrollBarVisibility="Auto" MaxHeight="250" Visibility="Collapsed">
                    <TextBlock x:Name="TxtTranslationResult" 
                               TextWrapping="Wrap" 
                               FontSize="13" 
                               LineHeight="20"
                               TextOptions.TextFormattingMode="Display">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="#F1F5F9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ScrollViewer>
            </Grid>

            <!-- ==================== 2. ORIGINAL TEXT (COLLAPSIBLE) ==================== -->
            <Border Grid.Row="2" Margin="14,0,14,6" Padding="8,5" CornerRadius="5" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="VĂN BẢN GỐC:" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtOriginalText" Grid.Row="1" FontSize="11" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#475569"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- ==================== 3. FOOTER ACTIONS ==================== -->
            <Border Grid.Row="3" CornerRadius="0,0,9,9" Padding="12,8" BorderThickness="0,1,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Buttons: Open Full Dialog / Copy -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnOpenFullDialog" Content="Bảng đầy đủ (F3)" Style="{StaticResource MiniBtnStyle}" 
                                ToolTip="Mở cửa sổ dịch và quản lý glossary đầy đủ" Click="OnOpenFullDialogClick" Margin="0,0,6,0"/>
                        <Button x:Name="BtnCopy" Content="📋 Sao chép" Style="{StaticResource MiniBtnStyle}" 
                                ToolTip="Sao chép bản dịch (Ctrl+C)" Click="OnCopyClick"/>
                    </StackPanel>

                    <!-- Right Button: Insert into Excel Cell -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnInsertCell" Content="📥 Chèn vào ô (Enter)" Style="{StaticResource PrimaryActionBtnStyle}" 
                                ToolTip="Ghi đè kết quả dịch vào ô hiện tại" Click="OnInsertCellClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

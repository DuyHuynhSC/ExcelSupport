<Window x:Class="ExcelSupport.Views.TableExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ExcelSupport.Helpers"
        Title="{loc:Loc TableExport_WindowTitle}" 
        Height="560" Width="740" 
        MinHeight="400" MinWidth="550"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Options Bar -->
            <RowDefinition Height="*"/>    <!-- Tabs Content (Markdown / HTML) -->
            <RowDefinition Height="Auto"/> <!-- Footer Status & Action Buttons -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{loc:Loc TableExport_HeaderTitle}" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="{loc:Loc TableExport_HeaderSubtitle}" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 2. Options -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="{loc:Loc TableExport_OptFirstRowHeader}" IsChecked="{Binding FirstRowAsHeader, Mode=TwoWay}" Margin="0,0,16,0"/>
                <CheckBox Content="{loc:Loc TableExport_OptAlignNumbersRight}" IsChecked="{Binding AlignNumbersRight, Mode=TwoWay}" Margin="0,0,16,0"/>
                <CheckBox Content="{loc:Loc TableExport_OptLineBreakToBr}" IsChecked="{Binding ConvertLineBreaksToBr, Mode=TwoWay}" Margin="0,0,16,0"/>
                <CheckBox Content="{loc:Loc TableExport_OptCompact}" IsChecked="{Binding CompactFormat, Mode=TwoWay}" Margin="0,0,16,0"/>
                <CheckBox Content="{loc:Loc TableExport_OptHtmlStyles}" IsChecked="{Binding IncludeHtmlStyles, Mode=TwoWay}" Margin="0,0,16,0"/>
            </WrapPanel>
        </Border>

        <!-- 3. Tabs Preview -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Background="#FFFFFF" BorderBrush="#CBD5E1">
            <TabItem Header="Markdown Table (.md)">
                <TextBox Text="{Binding MarkdownText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" Padding="10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="#F8FAFC"/>
            </TabItem>
            <TabItem Header="HTML Table (table)">
                <TextBox Text="{Binding HtmlText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" Padding="10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="#F8FAFC"/>
            </TabItem>
        </TabControl>

        <!-- 4. Footer -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="11.5" Foreground="#2563EB" FontWeight="Medium"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="🔄 Làm Mới Vùng Chọn" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryActionBtn}" Margin="0,0,8,0"/>
                <Button Content="📋 Copy Markdown Table" Command="{Binding CopyMarkdownCommand}" Style="{StaticResource PrimaryActionBtn}" Margin="0,0,8,0"/>
                <Button Content="📋 Copy HTML Table" Command="{Binding CopyHtmlCommand}" Style="{StaticResource SecondaryActionBtn}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

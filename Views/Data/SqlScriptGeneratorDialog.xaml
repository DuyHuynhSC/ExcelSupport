<Window x:Class="ExcelSupport.Views.SqlScriptGeneratorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ExcelSupport.Helpers"
        Title="{loc:Loc SqlGen_WindowTitle}"
        Height="720" Width="1100"
        MinHeight="580" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <!-- Boolean to Visibility Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Primary Action Button (Blue/Indigo) -->
        <Style x:Key="SqlPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SqlSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Accent Action Button (Purple/Oracle) -->
        <Style x:Key="SqlAccentBtn" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#6D28D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Container Style -->
        <Style x:Key="CardPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="BorderBrush" Value="#334155"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Text Input Style -->
        <Style x:Key="SqlInputTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Stat Pill Style -->
        <Style x:Key="StatPillBorder" TargetType="Border">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Header -->
            <RowDefinition Height="*"/>    <!-- 1. Content (2 columns) -->
            <RowDefinition Height="Auto"/> <!-- 2. Footer Status & Action Buttons -->
        </Grid.RowDefinitions>

        <!-- 0. Header Area -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🗄️" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{loc:Loc SqlGen_HeaderTitle}" FontSize="17" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock Text="{loc:Loc SqlGen_HeaderSubtitle}" FontSize="12" Foreground="#64748B" Margin="28,2,0,0"/>
            </StackPanel>

            <!-- Re-select Range Button -->
            <Button Grid.Column="1" Style="{StaticResource SqlSecondaryBtn}"
                    Command="{Binding RefreshFromSelectionCommand}"
                    ToolTip="{loc:Loc SqlGen_BtnRefreshSelection_Tip}"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" Margin="0,0,6,0"/>
                    <TextBlock Text="{loc:Loc SqlGen_BtnRefreshSelection}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 1. Main Content: 2 Columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450" MinWidth="380"/> <!-- Left: Settings & Column Mapping -->
                <ColumnDefinition Width="10"/>                 <!-- Splitter -->
                <ColumnDefinition Width="*" MinWidth="450"/>   <!-- Right: Realtime SQL Preview -->
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Settings & Columns -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Settings Form -->
                    <RowDefinition Height="*"/>    <!-- Column Mapping Grid -->
                </Grid.RowDefinitions>

                <!-- Settings Card -->
                <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Title -->
                        <TextBlock Text="{loc:Loc SqlGen_SectionSettings}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

                        <!-- Row 1: Target Table & Schema -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Loc SqlGen_LblSchema}" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,3"/>
                                <TextBox Style="{StaticResource SqlInputTextBox}" Text="{Binding SchemaName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Loc SqlGen_LblTableName}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBox Style="{StaticResource SqlInputTextBox}" Text="{Binding TableName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Database Dialect & Statement Type -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Loc SqlGen_LblDialect}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding AvailableDialects}" SelectedItem="{Binding SelectedDialect, Mode=TwoWay}" Padding="6,4"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Loc SqlGen_LblStatementType}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding AvailableStatementTypes}" SelectedItem="{Binding SelectedStatementType, Mode=TwoWay}" Padding="6,4"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: Options (Checkboxes) -->
                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,4">
                            <CheckBox Content="{loc:Loc SqlGen_OptFirstRowHeader}" IsChecked="{Binding FirstRowAsHeader, Mode=TwoWay}" Margin="0,4,14,4"/>
                            <CheckBox Content="{loc:Loc SqlGen_OptTreatBlankAsNull}" IsChecked="{Binding TreatBlankAsNull, Mode=TwoWay}" Margin="0,4,14,4"/>
                            <CheckBox Content="{loc:Loc SqlGen_OptTransaction}" IsChecked="{Binding IncludeTransaction, Mode=TwoWay}" Margin="0,4,14,4"/>
                            <CheckBox Content="{loc:Loc SqlGen_OptUnicodeNPrefix}" IsChecked="{Binding UseUnicodeNPrefix, Mode=TwoWay}" Margin="0,4,14,4"/>
                            <CheckBox Content="{loc:Loc SqlGen_OptIdentityInsert}" IsChecked="{Binding IncludeIdentityInsert, Mode=TwoWay}" 
                                      Visibility="{Binding IsIdentityInsertVisible, Converter={StaticResource BoolToVis}}" Margin="0,4,14,4"/>
                        </WrapPanel>

                        <!-- Batch Size input (Visible when InsertBatch) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0"
                                    Visibility="{Binding IsBatchSizeVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:Loc SqlGen_LblBatchSize}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Style="{StaticResource SqlInputTextBox}" Width="80" Text="{Binding BatchSize, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{loc:Loc SqlGen_LblRowsPerBatch}" VerticalAlignment="Center" Foreground="#64748B" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Column Mapping Grid Card -->
                <Border Grid.Row="1" Style="{StaticResource CardPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Column Card Header & Action buttons -->
                            <RowDefinition Height="*"/>    <!-- DataGrid of Columns -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc SqlGen_SectionColumns}" FontWeight="Bold" FontSize="13"/>
                                <Border Background="#E2E8F0" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Columns.Count}" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{loc:Loc SqlGen_BtnSelectAll}" Style="{StaticResource SqlSecondaryBtn}"
                                        Command="{Binding SelectAllColumnsCommand}" Padding="8,2" FontSize="11" Margin="0,0,4,0"/>
                                <Button Content="{loc:Loc SqlGen_BtnDeselectAll}" Style="{StaticResource SqlSecondaryBtn}"
                                        Command="{Binding DeselectAllColumnsCommand}" Padding="8,2" FontSize="11"/>
                            </StackPanel>
                        </Grid>

                        <!-- Column Mapping DataGrid -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Columns}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0" SelectionMode="Single"
                                  BorderThickness="1" BorderBrush="#CBD5E1" Background="#FFFFFF">
                            <DataGrid.Columns>
                                <!-- CheckBox: Export Column -->
                                <DataGridCheckBoxColumn Header="{loc:Loc SqlGen_ColHeaderSelect}" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>

                                <!-- Column Name in SQL (Editable) -->
                                <DataGridTextColumn Header="{loc:Loc SqlGen_ColHeaderName}" Binding="{Binding ColumnName, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="4,2"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Data Type ComboBox -->
                                <DataGridTemplateColumn Header="{loc:Loc SqlGen_ColHeaderType}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AvailableDataTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Padding="4,2" FontSize="11"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- CheckBox: PK / Key for MERGE & UPDATE -->
                                <DataGridCheckBoxColumn Header="{loc:Loc SqlGen_ColHeaderPrimaryKey}" Binding="{Binding IsPrimaryKey, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent" Cursor="SizeWE"/>

            <!-- RIGHT COLUMN: Realtime SQL Preview -->
            <Border Grid.Column="2" Style="{StaticResource CardPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Stats Bar -->
                        <RowDefinition Height="*"/>    <!-- SQL Preview TextBox -->
                    </Grid.RowDefinitions>

                    <!-- Stats Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Rows Stat -->
                            <Border Style="{StaticResource StatPillBorder}">
                                <TextBlock>
                                    <Run Text="{loc:Loc SqlGen_StatRows}" Foreground="#64748B"/>
                                    <Run Text="{Binding RowCount, StringFormat=': {0:N0}'}" FontWeight="Bold"/>
                                </TextBlock>
                            </Border>

                            <!-- Columns Stat -->
                            <Border Style="{StaticResource StatPillBorder}">
                                <TextBlock>
                                    <Run Text="{loc:Loc SqlGen_StatCols}" Foreground="#64748B"/>
                                    <Run Text="{Binding ColumnCount, StringFormat=': {0}'}" FontWeight="Bold"/>
                                </TextBlock>
                            </Border>

                            <!-- Statements Stat -->
                            <Border Style="{StaticResource StatPillBorder}">
                                <TextBlock>
                                    <Run Text="{loc:Loc SqlGen_StatStatements}" Foreground="#64748B"/>
                                    <Run Text="{Binding StatementCount, StringFormat=': {0:N0}'}" FontWeight="Bold" Foreground="#2563EB"/>
                                </TextBlock>
                            </Border>

                            <!-- Time Stat -->
                            <Border Style="{StaticResource StatPillBorder}">
                                <TextBlock>
                                    <Run Text="{loc:Loc SqlGen_StatTime}" Foreground="#64748B"/>
                                    <Run Text="{Binding ExecutionTimeMs, StringFormat=': {0} ms'}" FontWeight="SemiBold" Foreground="#107C41"/>
                                </TextBlock>
                            </Border>
                        </WrapPanel>

                        <!-- Loading Indicator -->
                        <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="80" Height="6" VerticalAlignment="Center"
                                     Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- Monospace SQL Output Box -->
                    <TextBox Grid.Row="1"
                             Text="{Binding SqlScriptText, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Cascadia Code, Courier New"
                             FontSize="12.5"
                             Padding="8"
                             Background="#0F172A"
                             Foreground="#38BDF8"
                             BorderBrush="#334155"
                             BorderThickness="1"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. Footer Area: Status Message & Action Buttons -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status Message -->
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                       FontWeight="Medium" FontSize="12" Foreground="#475569" TextTrimming="CharacterEllipsis"/>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- Copy to Clipboard -->
                <Button Style="{StaticResource SqlPrimaryBtn}" Command="{Binding CopyClipboardCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:Loc SqlGen_BtnCopyClipboard}"/>
                    </StackPanel>
                </Button>

                <!-- Save to .sql File -->
                <Button Style="{StaticResource SqlSecondaryBtn}" Command="{Binding SaveFileCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:Loc SqlGen_BtnSaveFile}"/>
                    </StackPanel>
                </Button>

                <!-- Open in Quick SQL Query (Oracle) -->
                <Button Style="{StaticResource SqlAccentBtn}" Command="{Binding SendToOracleQuickQueryCommand}"
                        Visibility="{Binding CanSendToOracleQuery, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:Loc SqlGen_BtnOpenInQuickQuery}"/>
                    </StackPanel>
                </Button>

                <!-- Close Button -->
                <Button Style="{StaticResource SqlSecondaryBtn}" Content="{loc:Loc Common_Close}" Click="OnCloseClick" Width="80"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

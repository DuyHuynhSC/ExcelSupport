<Window x:Class="ExcelSupport.Views.BatchFindReplaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ExcelSupport.Helpers"
        Title="{loc:Loc FindRep_WindowTitle}"
        Height="700" Width="1000"
        MinHeight="540" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <!-- Primary Action Button (Green) -->
        <Style x:Key="DialogPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#107C41"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0A552A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#063C1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="DialogSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Implicit RadioButton Style -->
        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#F1F5F9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Implicit CheckBox Style -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#F1F5F9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Implicit TextBlock Style -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Header Style -->
        <Style x:Key="GridHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F1F5F9"/>
                    <Setter Property="BorderBrush" Value="#334155"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Row Style -->
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- DataGridCell Style -->
        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#2563EB"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#60A5FA"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Header -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Main Content (Left: Input Dictionary, Right: Options & Table) -->
            <RowDefinition Height="*"/>
            <!-- 3. Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 1. HEADER ==================== -->
        <Border Grid.Row="0" Padding="20,12" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔄" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc FindRep_Title}" FontWeight="Bold" FontSize="15"/>
                </StackPanel>
                <TextBlock Text="{loc:Loc FindRep_SubTitle}" 
                           FontSize="11.5" Foreground="#64748B" Margin="30,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- ==================== 2. MAIN CONTENT ==================== -->
        <Grid Grid.Row="1" Margin="20,12,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: NHẬP BẢNG TRA CỨU (DICTIONARY INPUT) -->
            <Border Grid.Column="0" CornerRadius="8" Padding="14" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc FindRep_DictHeader}" FontWeight="Bold" FontSize="12.5"/>
                            <Border CornerRadius="10" Padding="8,2" Margin="10,0,0,0" Background="#E0F2FE">
                                <TextBlock x:Name="TxtPairCountBadge" Text="0" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{loc:Loc FindRep_DictSub}" 
                                   FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Khung nhập / dán text -->
                    <TextBox x:Name="TxtDictionaryInput" Grid.Row="1"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Padding="8" FontSize="12" FontFamily="Consolas, Segoe UI"
                             TextChanged="OnDictionaryTextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Background" Value="#0F172A"/>
                                        <Setter Property="Foreground" Value="#F8FAFC"/>
                                        <Setter Property="BorderBrush" Value="#475569"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Nút thao tác từ điển -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="{loc:Loc FindRep_BtnLoadSelection}" Style="{StaticResource DialogSecondaryBtn}"
                                HorizontalAlignment="Left" Click="OnLoadFromSelectionClick"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{loc:Loc FindRep_BtnPaste}" Style="{StaticResource DialogSecondaryBtn}" Margin="0,0,6,0" Click="OnPasteClipboardClick"/>
                            <Button Content="{loc:Loc FindRep_BtnClear}" Style="{StaticResource DialogSecondaryBtn}" Click="OnClearDictionaryClick"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT: CẤU HÌNH & BẢNG XEM TRƯỚC (OPTIONS & PREVIEW) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Card 1: Phạm Vi Thay Thế -->
                <Border Grid.Row="0" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="BorderBrush" Value="#334155"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <TextBlock Text="{loc:Loc Blank_SecScope}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,6"/>
                        <WrapPanel>
                            <RadioButton x:Name="RbScopeSelection" GroupName="FindReplaceScopeGroup" Content="{loc:Loc FindRep_ScopeSelection}" Cursor="Hand" Margin="0,0,20,4"/>
                            <RadioButton x:Name="RbScopeActiveSheet" GroupName="FindReplaceScopeGroup" Content="{loc:Loc FindRep_ScopeSheet}" IsChecked="True" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,20,4"/>
                            <RadioButton x:Name="RbScopeAllSheets" GroupName="FindReplaceScopeGroup" Content="{loc:Loc FindRep_ScopeWb}" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,20,4"/>
                            <RadioButton x:Name="RbScopeAllWorkbooks" GroupName="FindReplaceScopeGroup" Content="{loc:Loc FindRep_ScopeAllWb}" Cursor="Hand" Margin="0,0,20,4"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Card 2: Tùy Chọn Khớp & Đánh Dấu -->
                <Border Grid.Row="1" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="BorderBrush" Value="#334155"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <TextBlock Text="{loc:Loc Comp_OptionsHeader}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,4">
                            <CheckBox x:Name="ChkMatchEntireCell" Content="{loc:Loc FindRep_MatchEntire}" Cursor="Hand" Margin="0,0,20,4"/>
                            <CheckBox x:Name="ChkMatchCase" Content="{loc:Loc FindRep_CaseSensitive}" Cursor="Hand" Margin="0,0,20,4"/>
                            <CheckBox x:Name="ChkHighlight" Content="{loc:Loc FindRep_Highlight}" IsChecked="True" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,20,4"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Card 3: Bảng Thống Kê Danh Sách Từ Khóa -->
                <Border Grid.Row="2" CornerRadius="8" Padding="12" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="BorderBrush" Value="#334155"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{loc:Loc FindRep_PreviewList}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,6"/>

                        <DataGrid x:Name="GridPairs" Grid.Row="1"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                  SelectionMode="Single" BorderThickness="1">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="RowBackground" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="RowBackground" Value="#1E293B"/>
                                            <Setter Property="BorderBrush" Value="#334155"/>
                                            <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50"/>
                                <DataGridTextColumn Header="{loc:Loc FindRep_ColFind}" Binding="{Binding FindText}" Width="*"/>
                                <DataGridTextColumn Header="{loc:Loc FindRep_ColReplace}" Binding="{Binding ReplaceText}" Width="*"/>
                                <DataGridTextColumn Header="{loc:Loc FindRep_ColMatches}" Binding="{Binding MatchCount}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== 3. FOOTER ==================== -->
        <Border Grid.Row="2" Padding="20,12" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtFooterStatus" Text="" 
                           VerticalAlignment="Center" FontSize="12" Foreground="#64748B"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{loc:Loc FindRep_BtnExecute}" Style="{StaticResource DialogPrimaryBtn}" Margin="0,0,10,0" Click="OnExecuteReplaceClick"/>
                    <Button Content="{loc:Loc Common_Close}" Width="80" Style="{StaticResource DialogSecondaryBtn}" Click="OnCloseClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

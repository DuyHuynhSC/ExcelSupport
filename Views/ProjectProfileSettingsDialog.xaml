<Window x:Class="ExcelSupport.Views.ProjectProfileSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ExcelSupport.Helpers"
        Title="{loc:Loc SpecProfile_WindowTitle}"
        Width="900" Height="630"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <!-- Primary Action Button -->
        <Style x:Key="ProfPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#107C41"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0A552A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#063C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="ProfSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                                <Setter Property="BorderBrush" Value="#475569"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Secondary Button for Left Panel -->
        <Style x:Key="ProfCompactSecondaryBtn" TargetType="Button" BasedOn="{StaticResource ProfSecondaryBtn}">
            <Setter Property="Padding" Value="4,5"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="ProfDangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="4,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc SpecProfile_HeaderTitle}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{loc:Loc SpecProfile_HeaderSubtitle}"
                           FontSize="12" Foreground="#64748B" Margin="28,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Body: Two Columns (Left: Profile List, Right: Profile Details) -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Profile List -->
            <Border Grid.Column="0" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Loc SpecProfile_ProjectListTitle}" FontWeight="Bold" FontSize="13" Margin="4,0,0,8"/>

                    <ListBox x:Name="lstProfiles" Grid.Row="1" 
                             BorderThickness="0" 
                             SelectionChanged="OnProfileSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding RootFolder}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Active Badge -->
                                    <Border Grid.Column="1" x:Name="bdActive" 
                                            Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" 
                                            CornerRadius="4" Padding="4,1" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="ACTIVE" FontWeight="Bold" FontSize="9" Foreground="#15803D"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Profile Management Buttons -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="{loc:Loc SpecProfile_BtnAdd}" Style="{StaticResource ProfCompactSecondaryBtn}" Margin="0,0,2,0" Click="OnAddProfileClick"/>
                        <Button Grid.Column="1" Content="{loc:Loc SpecProfile_BtnClone}" Style="{StaticResource ProfCompactSecondaryBtn}" Margin="2,0,2,0" Click="OnCloneProfileClick"/>
                        <Button Grid.Column="2" Content="{loc:Loc SpecProfile_BtnDelete}" Style="{StaticResource ProfDangerBtn}" Margin="2,0,0,0" Click="OnDeleteProfileClick"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right Panel: Profile Configuration Form -->
            <Border x:Name="borderRightPanel" Grid.Column="2" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Active Status & Set Active Button -->
                        <Border x:Name="borderActiveBanner" CornerRadius="6" Padding="10,8" Margin="0,0,0,12" 
                                Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock x:Name="iconActiveStatus" Text="⚪" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc SpecProfile_StatusLabel}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblActiveStatus" Text="{loc:Loc SpecProfile_StatusActive}" FontWeight="Bold" FontSize="12" Foreground="#15803D" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button x:Name="btnSetActive" Grid.Column="1" 
                                        Content="{loc:Loc SpecProfile_BtnSetActive}" 
                                        Style="{StaticResource ProfSecondaryBtn}"
                                        Click="OnSetActiveClick"/>
                            </Grid>
                        </Border>

                        <!-- Project Name -->
                        <TextBlock Text="{loc:Loc SpecProfile_ProjectName}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtName" Height="28" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                        <!-- Root Folder -->
                        <TextBlock Text="{loc:Loc SpecProfile_RootFolder}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtRootFolder" Grid.Column="0" Height="28" FontSize="12" VerticalContentAlignment="Center" TextChanged="OnFolderFieldChanged"/>
                            <Button Grid.Column="1" Content="{loc:Loc SpecProfile_BrowseBtn}" Style="{StaticResource ProfSecondaryBtn}" Margin="6,0,0,0" Click="OnBrowseRootFolderClick"/>
                        </Grid>

                        <!-- Detailed Design (TKCT) Group -->
                        <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="BorderBrush" Value="#334155"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc SpecProfile_TkctGroup}" FontWeight="Bold" FontSize="12.5" Foreground="#1E40AF" Margin="0,0,0,6"/>
                                
                                <!-- TKCT Tiếng Việt -->
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc SpecProfile_TkctViFolder}" FontWeight="SemiBold" FontSize="11.5"/>
                                    <TextBlock x:Name="lblTkctViStatus" Grid.Column="1" Text="{loc:Loc SpecProfile_StatusValid}" FontSize="11" Foreground="#15803D" FontWeight="Bold"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtTkctViFolder" Grid.Column="0" Height="28" FontSize="12" VerticalContentAlignment="Center" TextChanged="OnFolderFieldChanged"/>
                                    <Button Grid.Column="1" Content="{loc:Loc SpecProfile_BrowseBtn}" Style="{StaticResource ProfSecondaryBtn}" Margin="6,0,0,0" Click="OnBrowseTkctViFolderClick"/>
                                </Grid>

                                <!-- TKCT Tiếng Nhật -->
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc SpecProfile_TkctJaFolder}" FontWeight="SemiBold" FontSize="11.5"/>
                                    <TextBlock x:Name="lblTkctJaStatus" Grid.Column="1" Text="{loc:Loc SpecProfile_StatusValid}" FontSize="11" Foreground="#15803D" FontWeight="Bold"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtTkctJaFolder" Grid.Column="0" Height="28" FontSize="12" VerticalContentAlignment="Center" TextChanged="OnFolderFieldChanged"/>
                                    <Button Grid.Column="1" Content="{loc:Loc SpecProfile_BrowseBtn}" Style="{StaticResource ProfSecondaryBtn}" Margin="6,0,0,0" Click="OnBrowseTkctJaFolderClick"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Basic Design (TKCB) Group -->
                        <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="BorderBrush" Value="#334155"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc SpecProfile_TkcbGroup}" FontWeight="Bold" FontSize="12.5" Foreground="#1E40AF" Margin="0,0,0,6"/>
                                
                                <!-- TKCB Tiếng Việt -->
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc SpecProfile_TkcbViFolder}" FontWeight="SemiBold" FontSize="11.5"/>
                                    <TextBlock x:Name="lblTkcbViStatus" Grid.Column="1" Text="{loc:Loc SpecProfile_StatusValid}" FontSize="11" Foreground="#15803D" FontWeight="Bold"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtTkcbViFolder" Grid.Column="0" Height="28" FontSize="12" VerticalContentAlignment="Center" TextChanged="OnFolderFieldChanged"/>
                                    <Button Grid.Column="1" Content="{loc:Loc SpecProfile_BrowseBtn}" Style="{StaticResource ProfSecondaryBtn}" Margin="6,0,0,0" Click="OnBrowseTkcbViFolderClick"/>
                                </Grid>

                                <!-- TKCB Tiếng Nhật -->
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc SpecProfile_TkcbJaFolder}" FontWeight="SemiBold" FontSize="11.5"/>
                                    <TextBlock x:Name="lblTkcbJaStatus" Grid.Column="1" Text="{loc:Loc SpecProfile_StatusValid}" FontSize="11" Foreground="#15803D" FontWeight="Bold"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtTkcbJaFolder" Grid.Column="0" Height="28" FontSize="12" VerticalContentAlignment="Center" TextChanged="OnFolderFieldChanged"/>
                                    <Button Grid.Column="1" Content="{loc:Loc SpecProfile_BrowseBtn}" Style="{StaticResource ProfSecondaryBtn}" Margin="6,0,0,0" Click="OnBrowseTkcbJaFolderClick"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Test Spec Folder -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc SpecProfile_TestFolder}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock x:Name="lblTestStatus" Grid.Column="1" Text="{loc:Loc SpecProfile_StatusValid}" FontSize="11" Foreground="#15803D" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtTestFolder" Grid.Column="0" Height="28" FontSize="12" VerticalContentAlignment="Center" TextChanged="OnFolderFieldChanged"/>
                            <Button Grid.Column="1" Content="{loc:Loc SpecProfile_BrowseBtn}" Style="{StaticResource ProfSecondaryBtn}" Margin="6,0,0,0" Click="OnBrowseTestFolderClick"/>
                        </Grid>

                        <!-- File Extensions Filter -->
                        <TextBlock Text="{loc:Loc SpecProfile_Extensions}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtExtensions" Height="28" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,0,10"
                                 Text=".xlsx;.xlsm;.xls;.docx;.pdf;.pptx"/>

                        <!-- Do Not Search Subfolders Checkbox -->
                        <CheckBox x:Name="chkDoNotSearchSubfolders" 
                                  Content="{loc:Loc SpecProfile_DoNotSearchSubfolders}"
                                  Margin="0,0,0,6"/>

                        <!-- Read-Only Default Option -->
                        <CheckBox x:Name="chkReadOnlyDefault" 
                                  Content="{loc:Loc SpecProfile_ReadOnlyDefault}"
                                  Margin="0,0,0,12"/>

                        <!-- Test Search Section -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc SpecProfile_TestSectionTitle}" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtTestKeyword" Grid.Column="0" Height="28" FontSize="12" VerticalContentAlignment="Center"
                                             Text="SCR"/>
                                    <ComboBox x:Name="cboTestDocType" Grid.Column="1" Width="100" Height="28" Margin="6,0,0,0" SelectedIndex="0">
                                        <ComboBoxItem Content="TKCT"/>
                                        <ComboBoxItem Content="TKCB"/>
                                        <ComboBoxItem Content="Test Spec"/>
                                    </ComboBox>
                                    <Button Grid.Column="2" Content="{loc:Loc SpecProfile_BtnTestScan}" Style="{StaticResource ProfSecondaryBtn}" Margin="6,0,0,0" Click="OnTestSearchClick"/>
                                </Grid>
                                <TextBlock x:Name="lblTestResult" Text="{loc:Loc SpecProfile_TestPrompt}" 
                                           FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="#94A3B8"
                       Text="{loc:Loc SpecProfile_StorageNote}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{loc:Loc SpecProfile_BtnClose}" Style="{StaticResource ProfSecondaryBtn}" Margin="0,0,8,0" Click="OnCloseClick"/>
                <Button Content="{loc:Loc SpecProfile_BtnSave}" Style="{StaticResource ProfPrimaryBtn}" Click="OnSaveClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

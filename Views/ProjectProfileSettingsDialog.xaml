<Window x:Class="ExcelSupport.Views.ProjectProfileSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ExcelSupport.Helpers"
        Title="{loc:Loc SpecProfile_WindowTitle}"
        Width="880" Height="620"
        MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <!-- Primary Action Button -->
        <Style x:Key="ProfPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#107C41"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0A552A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#063C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="ProfSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                                <Setter Property="BorderBrush" Value="#475569"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="ProfDangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="CÀI ĐẶT PROFILE DỰ ÁN &amp; THƯ MỤC TÀI LIỆU THIẾT KẾ" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Quản lý đường dẫn thư mục tài liệu thiết kế (TKCT, TKCB, Test Spec) theo từng dự án phục vụ tra cứu nhanh bằng phím tắt."
                           FontSize="12" Foreground="#64748B" Margin="28,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Body: Two Columns (Left: Profile List, Right: Profile Details) -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Profile List -->
            <Border Grid.Column="0" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Danh sách dự án" FontWeight="Bold" FontSize="13" Margin="4,0,0,8"/>

                    <ListBox x:Name="lstProfiles" Grid.Row="1" 
                             BorderThickness="0" 
                             SelectionChanged="OnProfileSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding RootFolder}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Active Badge -->
                                    <Border Grid.Column="1" x:Name="bdActive" 
                                            Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" 
                                            CornerRadius="4" Padding="4,1" VerticalAlignment="Center" Margin="4,0,0,0"
                                            Visibility="Collapsed">
                                        <TextBlock Text="ACTIVE" FontWeight="Bold" FontSize="9" Foreground="#15803D"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Profile Management Buttons -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="➕ Thêm" Style="{StaticResource ProfSecondaryBtn}" Margin="0,0,2,0" Click="OnAddProfileClick"/>
                        <Button Grid.Column="1" Content="📋 Bản sao" Style="{StaticResource ProfSecondaryBtn}" Margin="2,0,2,0" Click="OnCloneProfileClick"/>
                        <Button Grid.Column="2" Content="🗑️ Xóa" Style="{StaticResource ProfDangerBtn}" Margin="2,0,0,0" Click="OnDeleteProfileClick"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right Panel: Profile Configuration Form -->
            <Border Grid.Column="2" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Active Status & Set Active Button -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Text="Trạng thái dự án: " FontSize="12" Foreground="#64748B"/>
                                <TextBlock x:Name="lblActiveStatus" Text="Đang kích hoạt (Active)" FontWeight="Bold" FontSize="12" Foreground="#15803D"/>
                            </StackPanel>

                            <Button x:Name="btnSetActive" Grid.Column="1" 
                                    Content="⭐ Đặt Làm Dự Án Đang Kích Hoạt" 
                                    Style="{StaticResource ProfSecondaryBtn}"
                                    Click="OnSetActiveClick"/>
                        </Grid>

                        <!-- Project Name -->
                        <TextBlock Text="Tên Dự Án (Project Name):" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtName" Height="28" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                        <!-- Root Folder -->
                        <TextBlock Text="Thư Mục Gốc Dự Án (Root Folder):" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtRootFolder" Grid.Column="0" Height="28" FontSize="12" VerticalContentAlignment="Center" TextChanged="OnFolderFieldChanged"/>
                            <Button Grid.Column="1" Content="📁 Duyệt..." Style="{StaticResource ProfSecondaryBtn}" Margin="6,0,0,0" Click="OnBrowseRootFolderClick"/>
                        </Grid>

                        <!-- Detailed Design Folder (TKCT) -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📄 Thư Mục Thiết Kế Chi Tiết (TKCT - Detailed Design):" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock x:Name="lblTkctStatus" Grid.Column="1" Text="✓ Hợp lệ" FontSize="11" Foreground="#15803D" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtTkctFolder" Grid.Column="0" Height="28" FontSize="12" VerticalContentAlignment="Center" TextChanged="OnFolderFieldChanged"/>
                            <Button Grid.Column="1" Content="📁 Duyệt..." Style="{StaticResource ProfSecondaryBtn}" Margin="6,0,0,0" Click="OnBrowseTkctFolderClick"/>
                        </Grid>

                        <!-- Basic Design Folder (TKCB) -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📐 Thư Mục Thiết Kế Cơ Bản (TKCB - Basic Design):" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock x:Name="lblTkcbStatus" Grid.Column="1" Text="✓ Hợp lệ" FontSize="11" Foreground="#15803D" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtTkcbFolder" Grid.Column="0" Height="28" FontSize="12" VerticalContentAlignment="Center" TextChanged="OnFolderFieldChanged"/>
                            <Button Grid.Column="1" Content="📁 Duyệt..." Style="{StaticResource ProfSecondaryBtn}" Margin="6,0,0,0" Click="OnBrowseTkcbFolderClick"/>
                        </Grid>

                        <!-- Test Spec Folder -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🧪 Thư Mục Chỉ Thị Test (Test Specification):" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock x:Name="lblTestStatus" Grid.Column="1" Text="✓ Hợp lệ" FontSize="11" Foreground="#15803D" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtTestFolder" Grid.Column="0" Height="28" FontSize="12" VerticalContentAlignment="Center" TextChanged="OnFolderFieldChanged"/>
                            <Button Grid.Column="1" Content="📁 Duyệt..." Style="{StaticResource ProfSecondaryBtn}" Margin="6,0,0,0" Click="OnBrowseTestFolderClick"/>
                        </Grid>

                        <!-- File Extensions Filter -->
                        <TextBlock Text="Định dạng file hỗ trợ (phân tách bởi dấu ;):" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtExtensions" Height="28" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,0,10"
                                 Text=".xlsx;.xlsm;.xls;.docx;.pdf;.pptx"/>

                        <!-- Read-Only Default Option -->
                        <CheckBox x:Name="chkReadOnlyDefault" 
                                  Content="Mặc định mở tài liệu dạng chỉ đọc (Read-Only) để bảo vệ an toàn tài liệu gốc"
                                  Margin="0,0,0,12"/>

                        <!-- Test Search Section -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="🔍 Thử nghiệm tìm kiếm trong dự án:" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtTestKeyword" Grid.Column="0" Height="28" FontSize="12" VerticalContentAlignment="Center"
                                             Text="SCR"/>
                                    <ComboBox x:Name="cboTestDocType" Grid.Column="1" Width="100" Height="28" Margin="6,0,0,0" SelectedIndex="0">
                                        <ComboBoxItem Content="TKCT"/>
                                        <ComboBoxItem Content="TKCB"/>
                                        <ComboBoxItem Content="Test Spec"/>
                                    </ComboBox>
                                    <Button Grid.Column="2" Content="Quét Thử" Style="{StaticResource ProfSecondaryBtn}" Margin="6,0,0,0" Click="OnTestSearchClick"/>
                                </Grid>
                                <TextBlock x:Name="lblTestResult" Text="Nhập từ khóa và bấm Quét Thử để kiểm tra kết quả tìm kiếm..." 
                                           FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="#94A3B8"
                       Text="Cấu hình được lưu tự động tại %APPDATA%\ExcelSupport\project_profiles.json"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Đóng" Style="{StaticResource ProfSecondaryBtn}" Margin="0,0,8,0" Click="OnCloseClick"/>
                <Button Content="💾 Lưu Cấu Hình" Style="{StaticResource ProfPrimaryBtn}" Click="OnSaveClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

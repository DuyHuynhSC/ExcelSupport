<Window x:Class="ExcelSupport.Views.VietnameseCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ExcelSupport.Models"
        Title="Kiểm Tra &amp; Định Vị Tiếng Việt Trong Workbooks" 
        Height="620" Width="940" 
        MinHeight="450" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Style DataGrid Header -->
        <Style x:Key="VnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F1F5F9"/>
                    <Setter Property="BorderBrush" Value="#334155"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style DataGrid Cell -->
        <Style x:Key="VnCellStyle" TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#1E3A8A"/>
                    <Setter Property="Foreground" Value="#93C5FD"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style DataGrid Row -->
        <Style x:Key="VnRowStyle" TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style Default TextBox for search -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="CaretBrush" Value="#0F172A"/>
            <Setter Property="SelectionBrush" Value="#3B82F6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                    <Setter Property="CaretBrush" Value="#F8FAFC"/>
                    <Setter Property="Background" Value="#1E293B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Scope Filter & Search Toolbar -->
            <RowDefinition Height="*"/>    <!-- DataGrid Results -->
            <RowDefinition Height="Auto"/> <!-- Footer & Actions -->
        </Grid.RowDefinitions>

        <!-- ==================== 1. HEADER ==================== -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="16,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🇻🇳 " FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Kiểm Tra &amp; Định Vị Tiếng Việt Trong Workbooks" FontWeight="Bold" FontSize="14" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Tự động quét các ô, tên Sheet và ghi chú để tìm các vị trí có tiếng Việt có dấu. Click đúp vào dòng để nhảy tới ô đó." 
                               FontSize="11" Margin="0,3,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Badge Tổng Số Vị Trí -->
                <Border Grid.Column="1" x:Name="BadgeResult" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FEF3C7"/>
                            <Setter Property="BorderBrush" Value="#FCD34D"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Background" Value="#78350F"/>
                                    <Setter Property="BorderBrush" Value="#D97706"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="TxtTotalCount" Text="0 vị trí phát hiện" FontWeight="Bold" FontSize="11.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#92400E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="#FDE68A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 2. TOOLBAR & FILTER ==================== -->
        <Border Grid.Row="1" Padding="16,8" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#F1F5F9"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Phạm vi quét -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Phạm vi quét:" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#334155"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <RadioButton x:Name="RbActiveWorkbook" Content="Workbook Hiện Tại" IsChecked="True" 
                                 GroupName="ScanScope" FontSize="11" Margin="0,0,8,0" Cursor="Hand" VerticalAlignment="Center"
                                 Checked="OnScopeRadioChecked">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Foreground" Value="#334155"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <RadioButton x:Name="RbActiveSheet" Content="Sheet Hiện Tại" 
                                 GroupName="ScanScope" FontSize="11" Margin="0,0,8,0" Cursor="Hand" VerticalAlignment="Center"
                                 Checked="OnScopeRadioChecked">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Foreground" Value="#334155"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <RadioButton x:Name="RbAllWorkbooks" Content="Tất Cả Workbook Đang Mở" 
                                 GroupName="ScanScope" FontSize="11" Margin="0,0,12,0" Cursor="Hand" VerticalAlignment="Center"
                                 Checked="OnScopeRadioChecked">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Foreground" Value="#334155"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <Button Content="🔍 Quét Ngay" Click="OnScanClick" 
                            Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" 
                            Padding="10,4" Cursor="Hand" Margin="0,0,10,0"/>
                </StackPanel>

                <!-- Ô tìm kiếm kết quả -->
                <Border Grid.Column="2" BorderThickness="1" CornerRadius="4" Padding="6,3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Background" Value="#0F172A"/>
                                    <Setter Property="BorderBrush" Value="#475569"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="TxtSearch" BorderThickness="0" Background="Transparent" 
                                 VerticalAlignment="Center" FontSize="11.5" TextChanged="OnSearchTextChanged"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 3. DATAGRID KẾT QUẢ ==================== -->
        <DataGrid Grid.Row="2" x:Name="GridResults" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  ColumnHeaderStyle="{StaticResource VnHeaderStyle}"
                  CellStyle="{StaticResource VnCellStyle}"
                  RowStyle="{StaticResource VnRowStyle}"
                  RowHeight="28"
                  BorderThickness="0"
                  Margin="16,10,16,6">
            <DataGrid.Style>
                <Style TargetType="DataGrid">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>
            <DataGrid.Columns>
                <!-- STT -->
                <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="45"/>

                <!-- Tên Workbook -->
                <DataGridTextColumn Header="📁 Tên File (Workbook)" Binding="{Binding WorkbookName}" Width="1.3*"/>

                <!-- Tên Sheet -->
                <DataGridTextColumn Header="📄 Tên Sheet" Binding="{Binding SheetName}" Width="1.2*"/>

                <!-- Địa Chỉ Ô -->
                <DataGridTextColumn Header="📍 Vị Trí" Binding="{Binding CellAddress}" Width="75" FontWeight="Bold"/>

                <!-- Loại Vị Trí -->
                <DataGridTextColumn Header="🏷️ Loại" Binding="{Binding TypeDescription}" Width="95"/>

                <!-- Nội Dung Phát Hiện -->
                <DataGridTextColumn Header="💬 Nội Dung Chứa Tiếng Việt" Binding="{Binding TextContent}" Width="3*"/>

                <!-- Nút Hành Động -->
                <DataGridTemplateColumn Header="Thao Tác" Width="95">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🎯 Đi tới ô" Click="OnGoToCellClick" 
                                    Padding="6,2" FontSize="11" Cursor="Hand"
                                    Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Foreground="#1D4ED8"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ==================== 4. FOOTER & ACTIONS ==================== -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" Padding="16,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Thông báo trạng thái -->
                <TextBlock Grid.Column="0" x:Name="TxtStatus" Text="💡 Gợi ý: Click đúp vào dòng để Excel tự động nhảy đến ô tính tương ứng." 
                           FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>

                <!-- Các nút Xuất báo cáo & Đóng -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📋 Tạo Sheet Báo Cáo" Click="OnCreateReportSheetClick" 
                            Background="#107C41" Foreground="#FFFFFF" FontWeight="Bold" 
                            Padding="12,6" Height="30" Margin="0,0,8,0" Cursor="Hand"
                            ToolTip="Tạo một sheet mới trên Excel chứa toàn bộ danh sách kèm Hyperlink nhảy tới ô"/>
                    
                    <Button Content="📤 Xuất File CSV..." Click="OnExportCsvClick" 
                            Padding="12,6" Height="30" Margin="0,0,8,0" Cursor="Hand"/>

                    <Button Content="Đóng" Click="OnCloseClick" 
                            Padding="12,6" Height="30" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

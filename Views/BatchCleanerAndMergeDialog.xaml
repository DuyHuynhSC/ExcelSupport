<Window x:Class="ExcelSupport.Views.BatchCleanerAndMergeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ExcelSupport.Helpers"
        Title="{loc:Loc Blank_WindowTitle}"
        Height="620" Width="860"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <!-- Primary Action Button (Green) -->
        <Style x:Key="DialogPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#107C41"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0A552A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#063C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="DialogSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Implicit RadioButton Style -->
        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#F1F5F9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Implicit CheckBox Style -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#F1F5F9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Implicit TextBlock Style -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="6"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" />
                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="{TemplateBinding Foreground}" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBoxItem Style -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#0369A1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          Focusable="false"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderThickness="1"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            CornerRadius="6"
                                            Margin="0,2,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" Opacity="0.15" Direction="270" ShadowDepth="2"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="30"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#2563EB"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#60A5FA"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Header -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Main Content Tabs -->
            <RowDefinition Height="*"/>
            <!-- 3. Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 1. HEADER ==================== -->
        <Border Grid.Row="0" Padding="20,12" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛠️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Blank_Title}" FontWeight="Bold" FontSize="14.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{loc:Loc Blank_SubTitle}" 
                               FontSize="11.5" Foreground="#64748B" Margin="30,2,0,0"/>
                </StackPanel>

                <!-- Badge Sheet hiện tại -->
                <Border Grid.Column="1" CornerRadius="12" Padding="10,4" Background="#E0F2FE" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtActiveSheetBadge" Text="Sheet" FontSize="11.5" FontWeight="Bold" Foreground="#0369A1"/>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 2. MAIN TABS ==================== -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="20,10,20,10" Background="Transparent" BorderThickness="0">

            <!-- TAB 1: XÓA DÒNG & CỘT TRỐNG HÀNG LOẠT -->
            <TabItem Header="{loc:Loc Blank_TabDeleteBlank}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <!-- Card 1: Phạm vi áp dụng -->
                        <Border CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="BorderBrush" Value="#334155"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Blank_SecScope}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <RadioButton x:Name="RbScopeActiveSheet" GroupName="ScopeGroup" Content="{loc:Loc Blank_ScopeSheet}" IsChecked="True" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,25,4"/>
                                    <RadioButton x:Name="RbScopeAllSheets" GroupName="ScopeGroup" Content="{loc:Loc Blank_ScopeWb}" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,25,4"/>
                                    <RadioButton x:Name="RbScopeAllWorkbooks" GroupName="ScopeGroup" Content="{loc:Loc Blank_ScopeAllWb}" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,25,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Tiêu chí xác định trống -->
                        <Border CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="BorderBrush" Value="#334155"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Blank_SecCriteria}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,8"/>
                                <StackPanel>
                                    <RadioButton x:Name="RbTargetEntireBlankRows" GroupName="BlankTargetGroup" Content="{loc:Loc Blank_CriteriaFullRow}" IsChecked="True" Cursor="Hand" Margin="0,0,0,8"/>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <RadioButton x:Name="RbTargetBlankKeyCol" GroupName="BlankTargetGroup" Content="{loc:Loc Blank_CriteriaKeyCol}" VerticalAlignment="Center" Cursor="Hand" Margin="0,0,10,0"/>
                                        <ComboBox x:Name="CboKeyColumn" Width="200" Height="26" VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <RadioButton x:Name="RbTargetEntireBlankCols" GroupName="BlankTargetGroup" Content="{loc:Loc Blank_CriteriaFullCol}" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Hành động xử lý -->
                        <Border CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="BorderBrush" Value="#334155"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Blank_SecAction}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <RadioButton x:Name="RbActionDelete" GroupName="ActionGroup" Content="{loc:Loc Blank_ActionDelete}" IsChecked="True" FontWeight="SemiBold" Foreground="#DC2626" Cursor="Hand" Margin="0,0,25,4"/>
                                    <RadioButton x:Name="RbActionHide" GroupName="ActionGroup" Content="{loc:Loc Blank_ActionHide}" FontWeight="SemiBold" Foreground="#D97706" Cursor="Hand" Margin="0,0,25,4"/>
                                    <RadioButton x:Name="RbActionHighlight" GroupName="ActionGroup" Content="{loc:Loc Blank_ActionHighlight}" FontWeight="SemiBold" Foreground="#2563EB" Cursor="Hand" Margin="0,0,25,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Nút thực thi Tab 1 -->
                        <Button Content="{loc:Loc Blank_BtnExecute}" Style="{StaticResource DialogPrimaryBtn}" 
                                HorizontalAlignment="Right" Padding="24,9" Click="OnExecuteBlankCleanupClick"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: GỘP Ô BẢO TOÀN DỮ LIỆU (SAFE CELL MERGE) -->
            <TabItem Header="{loc:Loc Blank_TabSafeMerge}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <!-- Thông tin vùng chọn -->
                        <Border CornerRadius="8" Padding="14" Margin="0,0,0,12" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Blank_MergeSelectionHeader}" FontWeight="Bold" FontSize="12.5" Foreground="#15803D" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtSelectionRangeInfo" Text="" FontSize="12" Foreground="#166534"/>
                            </StackPanel>
                        </Border>

                        <!-- Hướng Gộp -->
                        <Border CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="BorderBrush" Value="#334155"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Blank_MergeSecDirection}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,8"/>
                                <StackPanel>
                                    <RadioButton x:Name="RbMergeAcross" GroupName="MergeDirectionGroup" Content="{loc:Loc Blank_MergeAcross}" IsChecked="True" Cursor="Hand" Margin="0,0,0,8"/>
                                    <RadioButton x:Name="RbMergeDown" GroupName="MergeDirectionGroup" Content="{loc:Loc Blank_MergeDown}" Cursor="Hand" Margin="0,0,0,8"/>
                                    <RadioButton x:Name="RbMergeAll" GroupName="MergeDirectionGroup" Content="{loc:Loc Blank_MergeAll}" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Ký Tự Phân Cách -->
                        <Border CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="BorderBrush" Value="#334155"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Blank_MergeSecSeparator}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <RadioButton x:Name="RbSepComma" GroupName="SeparatorGroup" Content="{loc:Loc Blank_SepComma}" IsChecked="True" Cursor="Hand" Margin="0,0,20,4"/>
                                    <RadioButton x:Name="RbSepSpace" GroupName="SeparatorGroup" Content="{loc:Loc Blank_SepSpace}" Cursor="Hand" Margin="0,0,20,4"/>
                                    <RadioButton x:Name="RbSepSemicolon" GroupName="SeparatorGroup" Content="{loc:Loc Blank_SepSemicolon}" Cursor="Hand" Margin="0,0,20,4"/>
                                    <RadioButton x:Name="RbSepNewLine" GroupName="SeparatorGroup" Content="{loc:Loc Blank_SepNewLine}" Cursor="Hand" Margin="0,0,20,4"/>
                                    <RadioButton x:Name="RbSepPipe" GroupName="SeparatorGroup" Content="{loc:Loc Blank_SepPipe}" Cursor="Hand" Margin="0,0,20,4"/>
                                    <RadioButton x:Name="RbSepCustom" GroupName="SeparatorGroup" Content="{loc:Loc Blank_SepCustom}" Cursor="Hand" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                    <TextBox x:Name="TxtCustomSep" Width="90" Height="24" Text=" - " VerticalContentAlignment="Center"/>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ChkMergeIgnoreBlank" Content="{loc:Loc Blank_MergeIgnoreBlank}" IsChecked="True" Cursor="Hand" Margin="0,0,20,0"/>
                                    <CheckBox x:Name="ChkMergeTrim" Content="{loc:Loc Blank_MergeTrim}" IsChecked="True" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Nút thực thi Tab 2 -->
                        <Button Content="{loc:Loc Blank_BtnExecuteSafeMerge}" Style="{StaticResource DialogPrimaryBtn}" 
                                HorizontalAlignment="Right" Padding="24,9" Click="OnExecuteSafeMergeClick"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: GỘP NHIỀU SHEETS THÀNH 1 SHEET (COMBINE SHEETS) -->
            <TabItem Header="{loc:Loc Blank_TabCombineSheets}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Batch_SheetsHeader}" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{loc:Loc Common_SelectAll}" Style="{StaticResource DialogSecondaryBtn}" Margin="0,0,6,0" Click="OnSelectAllSheetsClick"/>
                            <Button Content="{loc:Loc Common_DeselectAll}" Style="{StaticResource DialogSecondaryBtn}" Click="OnDeselectAllSheetsClick"/>
                        </StackPanel>
                    </Grid>

                    <!-- Danh sách Sheets có CheckBox -->
                    <Border Grid.Row="1" CornerRadius="8" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="BorderBrush" Value="#475569"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <ListBox x:Name="ListSheets" Background="Transparent" BorderThickness="0" Padding="6">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding DisplayText}" Margin="4,3" Cursor="Hand" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Tùy Chọn Gộp Sheet -->
                    <Border Grid.Row="2" CornerRadius="8" Padding="14" Margin="0,10,0,10" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="BorderBrush" Value="#334155"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <CheckBox x:Name="ChkHasHeader" Content="{loc:Loc Batch_HeaderInRow1}" IsChecked="True" Cursor="Hand" Margin="0,0,0,8"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="ChkAddSourceCol" Content="{loc:Loc Batch_AddSourceCol}" IsChecked="True" VerticalAlignment="Center" Cursor="Hand" Margin="0,0,10,0"/>
                                <TextBox x:Name="TxtSourceColHeader" Width="180" Height="24" Text="Source Sheet" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <CheckBox x:Name="ChkCombineSkipBlank" Content="{loc:Loc Batch_SkipEmptyRows}" IsChecked="True" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- Nút thực thi Tab 3 -->
                    <Button Grid.Row="3" Content="{loc:Loc Batch_BtnCombineSheets}" Style="{StaticResource DialogPrimaryBtn}" 
                            HorizontalAlignment="Right" Padding="24,9" Click="OnExecuteCombineSheetsClick"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ==================== 3. FOOTER ==================== -->
        <Border Grid.Row="2" Padding="20,10" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="ExcelSupport" 
                           VerticalAlignment="Center" FontSize="11.5" Foreground="#64748B"/>
                
                <Button Grid.Column="1" Content="{loc:Loc Common_Close}" Width="90" Style="{StaticResource DialogSecondaryBtn}" Click="OnCloseClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>

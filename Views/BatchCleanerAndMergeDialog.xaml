<Window x:Class="ExcelSupport.Views.BatchCleanerAndMergeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xóa Dòng Trống &amp; Gộp Ô / Sheet Bảo Toàn Dữ Liệu — ExcelSupport"
        Height="620" Width="860"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <!-- Primary Action Button (Green) -->
        <Style x:Key="DialogPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#107C41"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0A552A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#063C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="DialogSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#2563EB"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#60A5FA"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Header -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Main Content Tabs -->
            <RowDefinition Height="*"/>
            <!-- 3. Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 1. HEADER ==================== -->
        <Border Grid.Row="0" Padding="20,12" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛠️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="XỬ LÝ DÒNG TRỐNG &amp; GỘP Ô / SHEET BẢO TOÀN DỮ LIỆU" FontWeight="Bold" FontSize="14.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Xóa dòng/cột trống hàng loạt trên nhiều Sheet, Gộp ô giữ nguyên 100% dữ liệu, Gộp nhiều sheet vào 1." 
                               FontSize="11.5" Foreground="#64748B" Margin="30,2,0,0"/>
                </StackPanel>

                <!-- Badge Sheet hiện tại -->
                <Border Grid.Column="1" CornerRadius="12" Padding="10,4" Background="#E0F2FE" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtActiveSheetBadge" Text="Sheet: Đang nạp..." FontSize="11.5" FontWeight="Bold" Foreground="#0369A1"/>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 2. MAIN TABS ==================== -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="20,10,20,10" Background="Transparent" BorderThickness="0">

            <!-- TAB 1: XÓA DÒNG & CỘT TRỐNG HÀNG LOẠT -->
            <TabItem Header="🧹 Xóa Dòng &amp; Cột Trống">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <!-- Card 1: Phạm vi áp dụng -->
                        <Border CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="BorderBrush" Value="#334155"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="📍 1. Phạm Vi Áp Dụng:" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <RadioButton x:Name="RbScopeActiveSheet" Content="Chỉ Sheet hiện tại" IsChecked="True" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,25,4"/>
                                    <RadioButton x:Name="RbScopeAllSheets" Content="Tất cả Sheets trong File hiện tại" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,25,4"/>
                                    <RadioButton x:Name="RbScopeAllWorkbooks" Content="Tất cả các File Excel đang mở" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,25,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Tiêu chí xác định trống -->
                        <Border CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="BorderBrush" Value="#334155"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="🎯 2. Tiêu Chí Xác Định Đối Tượng Trống:" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,8"/>
                                <StackPanel>
                                    <RadioButton x:Name="RbTargetEntireBlankRows" Content="Dòng hoàn toàn trống (Tất cả các ô trong dòng đều không có dữ liệu)" IsChecked="True" Cursor="Hand" Margin="0,0,0,8"/>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <RadioButton x:Name="RbTargetBlankKeyCol" Content="Dòng có Cột Khóa bị trống:" VerticalAlignment="Center" Cursor="Hand" Margin="0,0,10,0"/>
                                        <ComboBox x:Name="CboKeyColumn" Width="200" Height="26" VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <RadioButton x:Name="RbTargetEntireBlankCols" Content="Cột hoàn toàn trống (Tất cả các ô trong cột đều không có dữ liệu)" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Hành động xử lý -->
                        <Border CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="BorderBrush" Value="#334155"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="⚡ 3. Hành Động Xử Lý:" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <RadioButton x:Name="RbActionDelete" Content="Xóa vĩnh viễn (Shift Up/Left)" IsChecked="True" FontWeight="SemiBold" Foreground="#DC2626" Cursor="Hand" Margin="0,0,25,4"/>
                                    <RadioButton x:Name="RbActionHide" Content="Chỉ ẩn dòng/cột (Hidden)" FontWeight="SemiBold" Foreground="#D97706" Cursor="Hand" Margin="0,0,25,4"/>
                                    <RadioButton x:Name="RbActionHighlight" Content="Tô màu đánh dấu để kiểm tra" FontWeight="SemiBold" Foreground="#2563EB" Cursor="Hand" Margin="0,0,25,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Nút thực thi Tab 1 -->
                        <Button Content="⚡ Bắt Đầu Xử Lý Trống" Style="{StaticResource DialogPrimaryBtn}" 
                                HorizontalAlignment="Right" Padding="24,9" Click="OnExecuteBlankCleanupClick"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: GỘP Ô BẢO TOÀN DỮ LIỆU (SAFE CELL MERGE) -->
            <TabItem Header="🔗 Gộp Ô Không Mất Dữ Liệu">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <!-- Thông tin vùng chọn -->
                        <Border CornerRadius="8" Padding="14" Margin="0,0,0,12" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📍 Vùng Ô Đang Được Chọn Trên Excel:" FontWeight="Bold" FontSize="12.5" Foreground="#15803D" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtSelectionRangeInfo" Text="Vui lòng bôi đen 1 vùng ô trên Excel để gộp..." FontSize="12" Foreground="#166534"/>
                            </StackPanel>
                        </Border>

                        <!-- Hướng Gộp -->
                        <Border CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="BorderBrush" Value="#334155"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="📐 1. Hướng Gộp Ô:" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,8"/>
                                <StackPanel>
                                    <RadioButton x:Name="RbMergeAcross" Content="Gộp theo từng dòng (Merge Across: Nối nội dung các cột trong mỗi dòng lại)" IsChecked="True" Cursor="Hand" Margin="0,0,0,8"/>
                                    <RadioButton x:Name="RbMergeDown" Content="Gộp theo từng cột (Merge Down: Nối nội dung các dòng trong mỗi cột lại)" Cursor="Hand" Margin="0,0,0,8"/>
                                    <RadioButton x:Name="RbMergeAll" Content="Gộp toàn bộ vùng chọn thành 1 ô duy nhất (Merge All)" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Ký Tự Phân Cách -->
                        <Border CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="BorderBrush" Value="#334155"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="🔤 2. Ký Tự Phân Cách Khi Nối Chữ:" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <RadioButton x:Name="RbSepComma" Content="Dấu phẩy ( , )" IsChecked="True" Cursor="Hand" Margin="0,0,20,4"/>
                                    <RadioButton x:Name="RbSepSpace" Content="Dấu cách (Space)" Cursor="Hand" Margin="0,0,20,4"/>
                                    <RadioButton x:Name="RbSepSemicolon" Content="Dấu chấm phẩy ( ; )" Cursor="Hand" Margin="0,0,20,4"/>
                                    <RadioButton x:Name="RbSepNewLine" Content="Xuống dòng (Alt+Enter)" Cursor="Hand" Margin="0,0,20,4"/>
                                    <RadioButton x:Name="RbSepPipe" Content="Dấu gạch đứng ( | )" Cursor="Hand" Margin="0,0,20,4"/>
                                    <RadioButton x:Name="RbSepCustom" Content="Tùy chỉnh:" Cursor="Hand" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                    <TextBox x:Name="TxtCustomSep" Width="90" Height="24" Text=" - " VerticalContentAlignment="Center"/>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ChkMergeIgnoreBlank" Content="Bỏ qua các ô trống khi gộp" IsChecked="True" Cursor="Hand" Margin="0,0,20,0"/>
                                    <CheckBox x:Name="ChkMergeTrim" Content="Cắt khoảng trắng thừa đầu/cuối ô" IsChecked="True" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Nút thực thi Tab 2 -->
                        <Button Content="⚡ Gộp Ô Bảo Toàn Dữ Liệu" Style="{StaticResource DialogPrimaryBtn}" 
                                HorizontalAlignment="Right" Padding="24,9" Click="OnExecuteSafeMergeClick"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: GỘP NHIỀU SHEETS THÀNH 1 SHEET (COMBINE SHEETS) -->
            <TabItem Header="📊 Gộp Nhiều Sheet Vào 1">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📋 Chọn các Sheet cần gộp vào Sheet Tổng Hợp:" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Chọn Tất Cả" Style="{StaticResource DialogSecondaryBtn}" Margin="0,0,6,0" Click="OnSelectAllSheetsClick"/>
                            <Button Content="Bỏ Chọn Hết" Style="{StaticResource DialogSecondaryBtn}" Click="OnDeselectAllSheetsClick"/>
                        </StackPanel>
                    </Grid>

                    <!-- Danh sách Sheets có CheckBox -->
                    <Border Grid.Row="1" CornerRadius="8" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="BorderBrush" Value="#475569"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <ListBox x:Name="ListSheets" Background="Transparent" BorderThickness="0" Padding="6">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding DisplayText}" Margin="4,3" Cursor="Hand" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Tùy Chọn Gộp Sheet -->
                    <Border Grid.Row="2" CornerRadius="8" Padding="14" Margin="0,10,0,10" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="BorderBrush" Value="#334155"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <CheckBox x:Name="ChkHasHeader" Content="Dòng 1 là Tiêu đề (Chỉ lấy tiêu đề từ Sheet đầu tiên, bỏ qua tiêu đề các Sheet sau)" IsChecked="True" Cursor="Hand" Margin="0,0,0,8"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="ChkAddSourceCol" Content="Tự động thêm cột ghi tên Sheet nguồn:" IsChecked="True" VerticalAlignment="Center" Cursor="Hand" Margin="0,0,10,0"/>
                                <TextBox x:Name="TxtSourceColHeader" Width="180" Height="24" Text="Tên Sheet Nguồn" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <CheckBox x:Name="ChkCombineSkipBlank" Content="Tự động bỏ qua các dòng hoàn toàn trống" IsChecked="True" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- Nút thực thi Tab 3 -->
                    <Button Grid.Row="3" Content="⚡ Gộp Các Sheet Đã Chọn Vào Sheet Tổng Hợp" Style="{StaticResource DialogPrimaryBtn}" 
                            HorizontalAlignment="Right" Padding="24,9" Click="OnExecuteCombineSheetsClick"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ==================== 3. FOOTER ==================== -->
        <Border Grid.Row="2" Padding="20,10" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="ExcelSupport — Tiện ích xử lý dữ liệu và cấu trúc bảng tính chuyên nghiệp" 
                           VerticalAlignment="Center" FontSize="11.5" Foreground="#64748B"/>
                
                <Button Grid.Column="1" Content="Đóng" Width="90" Style="{StaticResource DialogSecondaryBtn}" Click="OnCloseClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>

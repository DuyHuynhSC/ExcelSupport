<Window x:Class="ExcelSupport.Views.AiFormulaDoctorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:ExcelSupport.Helpers"
        mc:Ignorable="d"
        Title="{loc:Loc FormulaDoc_Title}" 
        Height="700" Width="1050"
        MinHeight="580" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#0F172A" Opacity="0.05"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Success Button Style -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15803D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Form Input Style -->
        <Style x:Key="FormInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Tab Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER SECTION -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🩺" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc FormulaDoc_Title}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Border Background="#3B82F6" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc FormulaDoc_AiBadge}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{loc:Loc FormulaDoc_Subtitle}" FontSize="12" Foreground="#94A3B8" Margin="30,3,0,0"/>
                </StackPanel>

                <!-- Quick Action Buttons in Header -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnScanSheet" Style="{StaticResource PrimaryButtonStyle}" Content="{loc:Loc FormulaDoc_BtnScanSheet}" Click="BtnScanSheet_Click" Margin="0,0,8,0"/>
                    <Button x:Name="btnScanSelection" Style="{StaticResource SecondaryButtonStyle}" Content="{loc:Loc FormulaDoc_BtnScanSelection}" Click="BtnScanSelection_Click" Margin="0,0,8,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN TAB CONTROL -->
        <TabControl Grid.Row="1" Margin="14,10,14,0" Background="Transparent" BorderThickness="0">
            
            <!-- TAB 1: ERROR DOCTOR & FIXER -->
            <TabItem Header="{loc:Loc FormulaDoc_TabDoctor}" FontSize="13" FontWeight="SemiBold" Padding="14,8">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" MinWidth="320"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*" MinWidth="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Error Cells List -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- List Header & Stats -->
                                <RowDefinition Height="*"/>    <!-- DataGrid -->
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc FormulaDoc_ErrorListTitle}" FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" x:Name="badgeErrorCount" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="12" Padding="8,2">
                                    <TextBlock x:Name="txtErrorBadge" Text="0 lỗi" FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                                </Border>
                            </Grid>

                            <!-- DataGrid Error List -->
                            <DataGrid Grid.Row="1" x:Name="dgErrorCells"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      RowHeight="28"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FontSize="12"
                                      Background="#FFFFFF"
                                      BorderThickness="1"
                                      BorderBrush="#E2E8F0"
                                      SelectionChanged="DgErrorCells_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc FormulaDoc_ColCell}" Binding="{Binding CellAddress}" Width="55" FontWeight="SemiBold"/>
                                    <DataGridTemplateColumn Header="{loc:Loc FormulaDoc_ColErrorType}" Width="75">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#FEE2E2" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding ErrorTypeName}" FontWeight="Bold" FontSize="11" Foreground="#DC2626"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{loc:Loc FormulaDoc_ColHeader}" Binding="{Binding HeaderText}" Width="90" Foreground="#64748B"/>
                                    <DataGridTextColumn Header="{loc:Loc FormulaDoc_ColCurrentFormula}" Binding="{Binding Formula}" Width="*" FontFamily="Consolas" Foreground="#334155"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                    <!-- Right: AI Diagnosis & Fix Action Card -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Orientation="Vertical">
                                <!-- Selected Cell Header -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#EFF6FF" CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
                                            <TextBlock x:Name="txtSelectedCellBadge" Text="Ô: --" FontWeight="Bold" FontSize="12" Foreground="#1E40AF"/>
                                        </Border>
                                        <TextBlock Text="{loc:Loc FormulaDoc_DiagnosisHeader}" FontWeight="Bold" FontSize="14" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="btnReDiagnose" Style="{StaticResource SecondaryButtonStyle}" Content="{loc:Loc FormulaDoc_BtnReDiagnose}" Click="BtnReDiagnose_Click"/>
                                </Grid>

                                <!-- AI Diagnosis Box -->
                                <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <StackPanel Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="💡 " FontSize="12"/>
                                            <TextBlock Text="{loc:Loc FormulaDoc_RootCauseTitle}" FontWeight="Bold" FontSize="12" Foreground="#92400E"/>
                                        </StackPanel>
                                        <TextBlock x:Name="txtAiDiagnosis" Text="{loc:Loc FormulaDoc_SelectCellPrompt}" TextWrapping="Wrap" FontSize="12" Foreground="#78350F" LineHeight="18"/>
                                    </StackPanel>
                                </Border>

                                <!-- Current Formula View -->
                                <TextBlock Text="{loc:Loc FormulaDoc_CurrentFormulaLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtCurrentFormula" Style="{StaticResource FormInputStyle}" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="13" Margin="0,0,0,12"/>

                                <!-- Proposed Corrected Formula -->
                                <TextBlock Text="{loc:Loc FormulaDoc_ProposedFormulaLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#16A34A" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtProposedFormula" Style="{StaticResource FormInputStyle}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="#15803D" Margin="0,0,0,8"/>

                                <!-- Fix Explanation -->
                                <TextBlock x:Name="txtFixExplanation" Text="{loc:Loc FormulaDoc_FixExplanationPlaceholder}" TextWrapping="Wrap" FontSize="11" Foreground="#64748B" Margin="0,0,0,16"/>

                                <!-- Action Buttons (Apply to 1 Cell / Batch Column) -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button x:Name="btnBatchFixColumn" Style="{StaticResource SecondaryButtonStyle}" Content="{loc:Loc FormulaDoc_BtnBatchFixCol}" Click="BtnBatchFixColumn_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="btnApplyFix" Style="{StaticResource SuccessButtonStyle}" Content="{loc:Loc FormulaDoc_BtnApplyFix}" Click="BtnApplyFix_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: FORMULA EXPLAINER -->
            <TabItem Header="{loc:Loc FormulaDoc_TabExplainer}" FontSize="13" FontWeight="SemiBold" Padding="14,8">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{loc:Loc FormulaDoc_ExplainerTitle}" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc FormulaDoc_ExplainerSubtitle}" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                            <!-- Input Formula Box -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtExplainFormulaInput" Style="{StaticResource FormInputStyle}" FontFamily="Consolas" FontSize="13" Height="36" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="btnFetchActiveFormula" Style="{StaticResource SecondaryButtonStyle}" Content="{loc:Loc FormulaDoc_BtnGetActiveCell}" Click="BtnFetchActiveFormula_Click" Margin="8,0,0,0"/>
                                <Button Grid.Column="2" x:Name="btnRunExplain" Style="{StaticResource PrimaryButtonStyle}" Content="{loc:Loc FormulaDoc_BtnExplain}" Click="BtnRunExplain_Click" Margin="8,0,0,0"/>
                            </Grid>

                            <!-- Overall Purpose Card -->
                            <Border x:Name="cardExplainPurpose" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{loc:Loc FormulaDoc_PurposeHeader}" FontWeight="Bold" FontSize="12" Foreground="#1E40AF" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="txtOverallPurpose" Text="--" FontSize="12" Foreground="#1E3A8A" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Steps Breakdown List -->
                            <TextBlock Text="{loc:Loc FormulaDoc_StepsHeader}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="icExplainSteps">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#2563EB" CornerRadius="12" Width="24" Height="24" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding StepNumber}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding SubExpression}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#475569" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB 3: OPTIMIZER & MODERNIZER -->
            <TabItem Header="{loc:Loc FormulaDoc_TabModernizer}" FontSize="13" FontWeight="SemiBold" Padding="14,8">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{loc:Loc FormulaDoc_ModernizerTitle}" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc FormulaDoc_ModernizerSubtitle}" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                            <!-- Input Formula Box -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtModernizeInput" Style="{StaticResource FormInputStyle}" FontFamily="Consolas" FontSize="13" Height="36" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="btnFetchActiveForModernize" Style="{StaticResource SecondaryButtonStyle}" Content="{loc:Loc FormulaDoc_BtnGetActiveCell}" Click="BtnFetchActiveForModernize_Click" Margin="8,0,0,0"/>
                                <Button Grid.Column="2" x:Name="btnRunModernize" Style="{StaticResource PrimaryButtonStyle}" Content="{loc:Loc FormulaDoc_BtnModernize}" Click="BtnRunModernize_Click" Margin="8,0,0,0"/>
                            </Grid>

                            <!-- Modernized Output Card -->
                            <Border x:Name="cardModernizeOutput" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{loc:Loc FormulaDoc_ModernFormulaHeader}" FontWeight="Bold" FontSize="12" Foreground="#15803D" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtModernizedOutput" Style="{StaticResource FormInputStyle}" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="txtModernizeSummary" Text="--" FontSize="12" Foreground="#14532D" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Button x:Name="btnApplyModernized" Style="{StaticResource SuccessButtonStyle}" HorizontalAlignment="Right" Content="{loc:Loc FormulaDoc_BtnApplyToExcel}" Click="BtnApplyModernized_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- 3. FOOTER & STATUS BAR -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtStatus" Text="{loc:Loc FormulaDoc_StatusReady}" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                <ProgressBar x:Name="pbProgress" Grid.Column="1" Height="12" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Margin="10,0"/>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="{loc:Loc FormulaDoc_BtnClose}" Click="BtnClose_Click" Padding="14,4"/>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="ExcelSupport.Views.KatakanaValidatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ExcelSupport.Helpers"
        Title="{loc:Loc Katakana_WindowTitle}" 
        Height="640" Width="920" 
        MinHeight="480" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Controls -->
            <RowDefinition Height="*"/>    <!-- Main Split View (Groups & Details) -->
            <RowDefinition Height="Auto"/> <!-- Footer Status & Mass Actions -->
        </Grid.RowDefinitions>

        <!-- 1. Top Controls -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc Katakana_HeaderTitle}" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="{loc:Loc Katakana_HeaderSubtitle}" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{loc:Loc Katakana_BtnScan}" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryActionBtn}" MinWidth="130"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Katakana_ScopeLabel}" FontWeight="Medium" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton Content="{loc:Loc Katakana_ScopeSelection}" IsChecked="{Binding IsScopeSelection, Mode=TwoWay}" Margin="0,0,12,0"/>
                        <RadioButton Content="{loc:Loc Katakana_ScopeSheet}" IsChecked="{Binding IsScopeActiveSheet, Mode=TwoWay}" Margin="0,0,12,0"/>
                        <RadioButton Content="{loc:Loc Katakana_ScopeWorkbook}" IsChecked="{Binding IsScopeActiveWorkbook, Mode=TwoWay}" Margin="0,0,16,0"/>
                    </StackPanel>

                    <TextBox Grid.Column="2" Width="200" Height="26" Padding="6,2" VerticalContentAlignment="Center" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc Katakana_SearchFilterTip}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. Main Split: Groups List (Left) and Details / Action Panel (Right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="260"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Groups List -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding TotalFoundSummary}" FontWeight="SemiBold" FontSize="11.5" Foreground="#334155" Margin="4,0,0,6"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredGroups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding BaseStem}" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B"/>
                                            <TextBlock Text="{Binding DisplaySummary}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalOccurrences, StringFormat='{}{0} lần'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#2563EB"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Right: Details & Standardize Controls -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Selected Group Header & Actions -->
                        <RowDefinition Height="*"/>    <!-- Occurrences List -->
                    </Grid.RowDefinitions>

                    <!-- Group Action Box -->
                    <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="{Binding SelectedGroup.BaseStem, StringFormat='Nhóm từ gốc: [{0}]'}" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                <TextBlock Text="Chọn chuẩn từ vựng muốn áp dụng cho nhóm này:" FontSize="11" Foreground="#475569" Margin="0,2,0,0"/>
                            </StackPanel>

                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                <Button Command="{Binding StandardizeSelectedWithChouonCommand}" Style="{StaticResource SuccessActionBtn}" Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Đồng bộ CÓ trường âm: " FontSize="11"/>
                                        <TextBlock Text="{Binding SelectedGroup.WithChouonWord}" FontWeight="Bold" FontSize="11.5"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding StandardizeSelectedWithoutChouonCommand}" Style="{StaticResource SecondaryActionBtn}" Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Đồng bộ KHÔNG trường âm: " FontSize="11"/>
                                        <TextBlock Text="{Binding SelectedGroup.WithoutChouonWord}" FontWeight="Bold" FontSize="11.5"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Locations Table -->
                    <GroupBox Grid.Row="1" Header="{loc:Loc Katakana_LocationsListHeader}" Padding="6">
                        <DataGrid ItemsSource="{Binding SelectedGroup.Variants[0].Locations}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" SelectedItem="{Binding SelectedLocation, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sheet" Binding="{Binding SheetName}" Width="120"/>
                                <DataGridTextColumn Header="Ô" Binding="{Binding CellAddress}" Width="60"/>
                                <DataGridTextColumn Header="Nội dung trong ô" Binding="{Binding OriginalText}" Width="*"/>
                                <DataGridTemplateColumn Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Tới ô ↗" Style="{StaticResource SecondaryActionBtn}" Padding="4,1" FontSize="10" Command="{Binding DataContext.NavigateToCellCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Footer -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding ProgressStatus}" FontSize="11.5" Foreground="#2563EB" FontWeight="Medium" Margin="0,0,0,4"/>
                <ProgressBar Value="{Binding ProgressPercent}" Height="6" Maximum="100" Foreground="#2563EB" BorderThickness="0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{loc:Loc Katakana_BtnStandardizeAllJIS}" Command="{Binding StandardizeAllWithChouonCommand}" Style="{StaticResource PrimaryActionBtn}" ToolTip="{loc:Loc Katakana_BtnStandardizeAllJISTip}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

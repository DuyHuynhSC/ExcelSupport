<Window x:Class="ExcelSupport.Views.AdvancedFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bộ Lọc Dữ Liệu Nâng Cao (Smart Advanced Filter) — ExcelSupport"
        Height="720" Width="1060"
        MinHeight="560" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <!-- Primary Action Button (Green) -->
        <Style x:Key="FilterPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#107C41"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0A552A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#063C1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="FilterSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Button (Red) -->
        <Style x:Key="FilterDangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Header Style -->
        <Style x:Key="FilterGridHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F1F5F9"/>
                    <Setter Property="BorderBrush" Value="#334155"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Row Style -->
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Implicit RadioButton Style -->
        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#F1F5F9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Implicit CheckBox Style -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#F1F5F9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Implicit TextBlock Style -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Implicit DataGridCell Style -->
        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="6"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" />
                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="{TemplateBinding Foreground}" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBoxItem Style -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#0369A1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          Focusable="false"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderThickness="1"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            CornerRadius="6"
                                            Margin="0,2,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" Opacity="0.15" Direction="270" ShadowDepth="2"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="30"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#2563EB"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#60A5FA"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Header -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Main Tabs -->
            <RowDefinition Height="1.2*"/>
            <!-- 3. Live Preview Section -->
            <RowDefinition Height="*"/>
            <!-- 4. Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 1. HEADER ==================== -->
        <Border Grid.Row="0" Padding="20,12" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="BỘ LỌC DỮ LIỆU NÂNG CAO (SMART ADVANCED FILTER)" FontWeight="Bold" FontSize="15">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Lọc đa điều kiện phức tạp (AND/OR), lọc theo danh sách Paste từ clipboard, biểu thức số lồng nhau." 
                               FontSize="11.5" Foreground="#64748B" Margin="30,2,0,0"/>
                </StackPanel>

                <!-- Nút Hiện tất cả / Xóa lọc -->
                <Button Grid.Column="1" Content="🔄 Xóa Lọc (Hiện Lại Tất Cả)" Style="{StaticResource FilterSecondaryBtn}" 
                        VerticalAlignment="Center" Click="OnClearFilterClick"/>
            </Grid>
        </Border>

        <!-- ==================== 2. MAIN TABS ==================== -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="20,8,20,4" Background="Transparent" BorderThickness="0"
                    SelectionChanged="OnTabSelectionChanged">
            
            <!-- TAB 1: LỌC THEO DANH SÁCH PASTE -->
            <TabItem Header="📋 Lọc Theo Danh Sách Paste (Batch List)">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Chọn Cột Mục Tiêu -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="🎯 Cột Cần Lọc:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CboBatchColumn" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                                  SelectionChanged="OnBatchColumnChanged"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                            <RadioButton x:Name="RbWhitelist" Content="Chỉ giữ lại danh sách (Whitelist)" IsChecked="True" 
                                         FontWeight="SemiBold" Cursor="Hand" Margin="0,0,15,0" Checked="OnBatchOptionChanged"/>
                            <RadioButton x:Name="RbBlacklist" Content="Loại trừ danh sách (Blacklist)" 
                                         FontWeight="SemiBold" Cursor="Hand" Checked="OnBatchOptionChanged"/>
                        </StackPanel>

                        <!-- Thống kê danh sách -->
                        <Border Grid.Column="3" CornerRadius="12" Padding="10,4" Background="#E0F2FE">
                            <TextBlock x:Name="TxtBatchCountBadge" Text="0 giá trị duy nhất" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                        </Border>
                    </Grid>

                    <!-- Khung Dán Danh Sách -->
                    <TextBox x:Name="TxtBatchPaste" Grid.Row="1" 
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Padding="8" FontSize="12" FontFamily="Consolas, Segoe UI"
                             TextChanged="OnBatchPasteTextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="Foreground" Value="#F8FAFC"/>
                                        <Setter Property="BorderBrush" Value="#475569"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Tùy Chọn & Nút Thao Tác Paste -->
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkBatchExact" Content="So khớp chính xác từng ô (Exact Match)" IsChecked="True" 
                                      FontSize="11.5" Cursor="Hand" Margin="0,0,15,0" Checked="OnBatchOptionChanged" Unchecked="OnBatchOptionChanged"/>
                            <CheckBox x:Name="ChkBatchCase" Content="Phân biệt chữ hoa / thường" 
                                      FontSize="11.5" Cursor="Hand" Checked="OnBatchOptionChanged" Unchecked="OnBatchOptionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="📋 Dán từ Clipboard" Style="{StaticResource FilterSecondaryBtn}" Margin="0,0,8,0" Click="OnPasteFromClipboardClick"/>
                            <Button Content="🧹 Xóa Nội Dung" Style="{StaticResource FilterSecondaryBtn}" Click="OnClearBatchTextClick"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: TRÌNH XÂY DỰNG ĐA ĐIỀU KIỆN (VISUAL BUILDER) -->
            <TabItem Header="⚙️ Đa Điều Kiện (Visual Builder)">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <!-- Top Toolbar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Groups ScrollViewer -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Toán tử liên kết giữa các nhóm:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CboOuterOperator" Grid.Column="1" Width="140" Height="26" VerticalContentAlignment="Center"
                                  SelectionChanged="OnOuterOperatorChanged">
                            <ComboBoxItem Content="HOẶC (OR)" IsSelected="True"/>
                            <ComboBoxItem Content="VÀ (AND)"/>
                        </ComboBox>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="➕ Thêm Nhóm Điều Kiện" Style="{StaticResource FilterSecondaryBtn}" Click="OnAddGroupClick"/>
                        </StackPanel>
                    </Grid>

                    <!-- Danh sách các Nhóm Điều Kiện -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="StackGroups" Margin="0,0,5,0"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 3: BIỂU THỨC NHANH (QUICK EXPRESSION) -->
            <TabItem Header="⌨️ Biểu Thức Nhanh (Quick Expression)">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="🎯 Cột Áp Dụng Mặc Định:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CboQuickColumn" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                                  SelectionChanged="OnQuickColumnChanged"/>
                    </Grid>

                    <!-- Input Box -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="TxtQuickExpression" Grid.Row="0" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                                 FontSize="13" FontFamily="Consolas, Segoe UI" TextChanged="OnQuickExpressionChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                            <Setter Property="BorderBrush" Value="#475569"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock IsHitTestVisible="False" Text="Nhập biểu thức (vd: (> 0 and &lt; 50) or > 250)..." 
                                   VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="#94A3B8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtQuickExpression}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Gợi ý mẫu -->
                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="12" CornerRadius="8" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="BorderBrush" Value="#334155"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="💡 Cú pháp mẫu hỗ trợ:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="(> 0 and &lt; 50) or > 250" Style="{StaticResource FilterSecondaryBtn}" Padding="6,3" FontSize="11" Margin="0,0,6,4" Click="OnSampleExprClick"/>
                                <Button Content="(>= 100 and &lt;= 500) or == 0" Style="{StaticResource FilterSecondaryBtn}" Padding="6,3" FontSize="11" Margin="0,0,6,4" Click="OnSampleExprClick"/>
                                <Button Content="contains('VIP') or contains('Đại lý')" Style="{StaticResource FilterSecondaryBtn}" Padding="6,3" FontSize="11" Margin="0,0,6,4" Click="OnSampleExprClick"/>
                                <Button Content="startswith('HN') or endswith('VN')" Style="{StaticResource FilterSecondaryBtn}" Padding="6,3" FontSize="11" Margin="0,0,6,4" Click="OnSampleExprClick"/>
                            </WrapPanel>
                            <TextBlock Text="• Hỗ trợ các toán tử: &gt;, &gt;=, &lt;, &lt;=, ==, !=, contains('...'), startswith('...'), endswith('...'), regex('...')" 
                                       FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ==================== 3. LIVE PREVIEW SECTION ==================== -->
        <Grid Grid.Row="2" Margin="20,4,20,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tiêu đề Preview & Thống kê -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👁️ Xem Trước Kết Quả (Live Preview)" FontWeight="Bold" FontSize="12.5" Margin="0,0,12,0"/>
                    <Border x:Name="BdPreviewBadge" CornerRadius="12" Padding="10,3" Background="#DCFCE7">
                        <TextBlock x:Name="TxtPreviewBadge" Text="🎯 Thỏa mãn: 0 / 0 dòng (0%)" FontSize="11.5" FontWeight="Bold" Foreground="#15803D"/>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Hiển thị tối đa 12 dòng đầu tiên thỏa mãn" 
                           VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" Foreground="#64748B"/>
            </Grid>

            <!-- Bảng DataGrid Preview -->
            <DataGrid x:Name="GridPreview" Grid.Row="1"
                      AutoGenerateColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      ColumnHeaderStyle="{StaticResource FilterGridHeaderStyle}"
                      SelectionMode="Single" BorderThickness="1">
                <DataGrid.Style>
                    <Style TargetType="DataGrid">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="RowBackground" Value="#FFFFFF"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="RowBackground" Value="#1E293B"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                                <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
            </DataGrid>
        </Grid>

        <!-- ==================== 4. FOOTER ACTIONS ==================== -->
        <Border Grid.Row="3" Padding="20,12" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left action buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🎨 Tô Màu Highlight" Style="{StaticResource FilterSecondaryBtn}" Margin="0,0,8,0" Click="OnHighlightClick"/>
                    <Button Content="📋 Trích Xuất Sang Sheet Mới" Style="{StaticResource FilterSecondaryBtn}" Margin="0,0,8,0" Click="OnExtractClick"/>
                </StackPanel>

                <!-- Right primary action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="⚡ Áp Dụng Lọc (Filter In-Place)" Style="{StaticResource FilterPrimaryBtn}" Margin="0,0,10,0" Click="OnApplyFilterClick"/>
                    <Button Content="Đóng" Width="80" Style="{StaticResource FilterSecondaryBtn}" Click="OnCloseClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

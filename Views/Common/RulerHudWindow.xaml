<Window x:Class="ExcelSupport.Views.RulerHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ExcelSupport.Helpers"
        Title="Ruler Plus Quick Stats HUD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Mini Icon Button Style -->
        <Style x:Key="HudMiniBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stat Pill Badge Style -->
        <Style x:Key="StatBadgeBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <!-- Outer Container with Drop Shadow & Drag Handle -->
    <Border Margin="8" CornerRadius="10" BorderThickness="1.5" Padding="12,8"
            MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#0F172A"/>
                <Setter Property="BorderBrush" Value="#38BDF8"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.45"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="BorderBrush" Value="#0284C7"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.25"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <!-- 0. Header / Controls Bar -->
                <RowDefinition Height="Auto"/>
                <!-- 1. Row & Col Stats Content -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==================== 0. HEADER ==================== -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Active Cell Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎯" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="RULER PLUS STATS" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                        <Setter Property="Foreground" Value="#0369A1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border CornerRadius="4" Padding="6,1" Background="#0284C7">
                        <TextBlock x:Name="TxtCellBadge" Text="A1" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                    </Border>
                </StackPanel>

                <!-- Right: Font Size +/- and Close buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Hud_FontSize}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Button Content="A-" Style="{StaticResource HudMiniBtnStyle}" ToolTip="{loc:Loc Hud_DecreaseFontSize}" Click="OnDecreaseFontSizeClick"/>
                    <TextBlock x:Name="TxtFontSizeDisplay" Text="14" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="2,0"/>
                    <Button Content="A+" Style="{StaticResource HudMiniBtnStyle}" ToolTip="{loc:Loc Hud_IncreaseFontSize}" Click="OnIncreaseFontSizeClick"/>
                    <Rectangle Width="1" Height="12" Fill="#475569" Margin="6,0"/>
                    <Button Content="✕" Style="{StaticResource HudMiniBtnStyle}" ToolTip="{loc:Loc Hud_Close}" Click="OnCloseHudClick"/>
                </StackPanel>
            </Grid>

            <!-- ==================== 1. MAIN STATS CONTENT ==================== -->
            <StackPanel Grid.Row="1" Orientation="Vertical">

                <!-- ROW STATS LINE -->
                <Border CornerRadius="6" Padding="8,5" Margin="0,0,0,6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <WrapPanel VerticalAlignment="Center">
                        <!-- Row Identifier -->
                        <Border Background="#F59E0B" CornerRadius="4" Padding="6,2" Margin="0,0,8,2">
                            <TextBlock x:Name="TxtRowLabel" Text="ROW 1" FontWeight="Bold" Foreground="#FFFFFF" FontSize="{Binding DynamicFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Border>

                        <!-- Row Sum -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Hud_Sum}" Foreground="#94A3B8" FontSize="{Binding DynamicFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <TextBlock x:Name="TxtRowSum" Text="0" FontWeight="Bold" Foreground="#10B981" FontSize="{Binding DynamicFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>

                        <!-- Row Avg -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Hud_Avg}" Foreground="#94A3B8" FontSize="{Binding DynamicFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <TextBlock x:Name="TxtRowAvg" Text="0" FontWeight="Bold" Foreground="#38BDF8" FontSize="{Binding DynamicFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>

                        <!-- Row Count -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Hud_Count}" Foreground="#94A3B8" FontSize="{Binding DynamicFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <TextBlock x:Name="TxtRowCount" Text="0" FontWeight="Bold" Foreground="#C084FC" FontSize="{Binding DynamicFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>

                        <!-- Row Max/Min -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Hud_MaxMin}" Foreground="#94A3B8" FontSize="{Binding DynamicFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <TextBlock x:Name="TxtRowMaxMin" Text="0 / 0" FontWeight="SemiBold" Foreground="#F43F5E" FontSize="{Binding DynamicFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!-- COLUMN STATS LINE -->
                <Border CornerRadius="6" Padding="8,5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <WrapPanel VerticalAlignment="Center">
                        <!-- Col Identifier -->
                        <Border Background="#6366F1" CornerRadius="4" Padding="6,2" Margin="0,0,8,2">
                            <TextBlock x:Name="TxtColLabel" Text="COL A" FontWeight="Bold" Foreground="#FFFFFF" FontSize="{Binding DynamicFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Border>

                        <!-- Col Sum -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Hud_Sum}" Foreground="#94A3B8" FontSize="{Binding DynamicFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <TextBlock x:Name="TxtColSum" Text="0" FontWeight="Bold" Foreground="#10B981" FontSize="{Binding DynamicFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>

                        <!-- Col Avg -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Hud_Avg}" Foreground="#94A3B8" FontSize="{Binding DynamicFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <TextBlock x:Name="TxtColAvg" Text="0" FontWeight="Bold" Foreground="#38BDF8" FontSize="{Binding DynamicFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>

                        <!-- Col Count -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Hud_Count}" Foreground="#94A3B8" FontSize="{Binding DynamicFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <TextBlock x:Name="TxtColCount" Text="0" FontWeight="Bold" Foreground="#C084FC" FontSize="{Binding DynamicFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>

                        <!-- Col Max/Min -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Hud_MaxMin}" Foreground="#94A3B8" FontSize="{Binding DynamicFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <TextBlock x:Name="TxtColMaxMin" Text="0 / 0" FontWeight="SemiBold" Foreground="#F43F5E" FontSize="{Binding DynamicFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>

            </StackPanel>
        </Grid>
    </Border>
</Window>

<UserControl x:Class="ExcelSupport.Views.ProjectProfileSettingsControl"
             x:Name="RootProfileSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:ExcelSupport.Helpers"
             mc:Ignorable="d"
             FontFamily="Segoe UI" FontSize="12"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <!-- Form Input Style -->
        <Style x:Key="ProfInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, ElementName=RootProfileSettingsControl}" Value="False">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="Foreground" Value="#1E293B"/>
                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                    <Setter Property="CaretBrush" Value="#1E293B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDarkTheme, ElementName=RootProfileSettingsControl}" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                    <Setter Property="CaretBrush" Value="#38BDF8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="ProfPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Button (Save) -->
        <Style x:Key="ProfSuccessBtn" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#166534"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="ProfSecondaryBtn" TargetType="Button">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme, ElementName=RootProfileSettingsControl}" Value="False">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Foreground" Value="#334155"/>
                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDarkTheme, ElementName=RootProfileSettingsControl}" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#F1F5F9"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="ProfDangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern SubTabItem Style -->
        <Style x:Key="SubTabItemStyle" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2.5" Padding="12,7" Margin="0,0,8,0" Cursor="Hand">
                            <ContentPresenter x:Name="tabContent" ContentSource="Header" TextBlock.FontWeight="SemiBold" TextBlock.FontSize="12" TextBlock.Foreground="#64748B"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="tabContent" Property="TextBlock.Foreground" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="tabContent" Property="TextBlock.FontWeight" Value="Bold"/>
                                <Setter TargetName="tabContent" Property="TextBlock.Foreground" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT PANEL: PROJECT PROFILES LIST ================= -->
        <Border Grid.Column="0" CornerRadius="8" Padding="10" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, ElementName=RootProfileSettingsControl}" Value="True">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Loc SpecProfile_ProjectListTitle}" FontWeight="Bold" FontSize="12.5" Margin="2,0,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#0F172A"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkTheme, ElementName=RootProfileSettingsControl}" Value="True">
                                    <Setter Property="Foreground" Value="#F8FAFC"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- ListBox Profiles -->
                <ListBox x:Name="lstProfiles" Grid.Row="1" BorderThickness="0" Background="Transparent"
                         SelectionChanged="LstProfiles_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="Foreground" Value="#0F172A"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="itemBorder" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="#F1F5F9"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="#EFF6FF"/>
                                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#BFDBFE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="#1E40AF"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsDarkTheme, ElementName=RootProfileSettingsControl}" Value="True">
                                    <Setter Property="Foreground" Value="#F8FAFC"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsDarkTheme, ElementName=RootProfileSettingsControl}" Value="True"/>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Foreground" Value="#60A5FA"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="#1E40AF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDarkTheme, ElementName=RootProfileSettingsControl}" Value="True">
                                                        <Setter Property="Foreground" Value="#F8FAFC"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDarkTheme, ElementName=RootProfileSettingsControl}" Value="True"/>
                                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="#93C5FD"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding RootFolder}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDarkTheme, ElementName=RootProfileSettingsControl}" Value="True">
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Active Badge -->
                                <Border Grid.Column="1" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" 
                                        CornerRadius="4" Padding="5,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="ACTIVE" FontWeight="Bold" FontSize="9" Foreground="#15803D"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Project List Action Buttons -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{loc:Loc SpecProfile_BtnAdd}" Style="{StaticResource ProfSecondaryBtn}" Height="30" Margin="0,0,2,0" Click="BtnAddProject_Click"/>
                    <Button Grid.Column="1" Content="{loc:Loc SpecProfile_BtnClone}" Style="{StaticResource ProfSecondaryBtn}" Height="30" Margin="2,0,2,0" Click="BtnCloneProject_Click"/>
                    <Button Grid.Column="2" Content="{loc:Loc SpecProfile_BtnDelete}" Style="{StaticResource ProfDangerBtn}" Height="30" Margin="2,0,0,0" Click="BtnDeleteProject_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= RIGHT PANEL: UNIFIED CONFIGURATION FORM ================= -->
        <Border Grid.Column="2" CornerRadius="8" Padding="14" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme, ElementName=RootProfileSettingsControl}" Value="True">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Active Project Banner -->
                <Border Grid.Row="0" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkTheme, ElementName=RootProfileSettingsControl}" Value="True">
                                    <Setter Property="Background" Value="#0F172A"/>
                                    <Setter Property="BorderBrush" Value="#334155"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock x:Name="iconActiveStatus" Text="⚪" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc SpecProfile_StatusLabel}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblActiveStatus" Text="{loc:Loc SpecProfile_StatusActive}" FontWeight="Bold" FontSize="12" Foreground="#15803D" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button x:Name="btnSetActive" Grid.Column="1" 
                                Content="{loc:Loc SpecProfile_BtnSetActive}" 
                                Style="{StaticResource ProfSecondaryBtn}"
                                Padding="12,5"
                                Click="BtnSetActive_Click"/>
                    </Grid>
                </Border>

                <!-- Sub-Tabs: Documents vs Database -->
                <TabControl Grid.Row="1" BorderThickness="0" Background="Transparent" Margin="0,0,0,10">
                    <!-- SUB-TAB 1: TÀI LIỆU DỰ ÁN (DOCUMENTS) -->
                    <TabItem Header="{loc:Loc SpecProfile_TabDocuments}" Style="{StaticResource SubTabItemStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,6,0">
                            <StackPanel>
                                <!-- Project Name -->
                                <TextBlock Text="{loc:Loc SpecProfile_ProjectName}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtName" Style="{StaticResource ProfInputStyle}" Height="32" Margin="0,0,0,10" TextChanged="TxtName_TextChanged"/>

                                <!-- Root Folder -->
                                <TextBlock Text="{loc:Loc SpecProfile_RootFolder}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtRootFolder" Grid.Column="0" Style="{StaticResource ProfInputStyle}" Height="32" TextChanged="OnFolderFieldChanged"/>
                                    <Button Grid.Column="1" Content="{loc:Loc SpecProfile_BrowseBtn}" Style="{StaticResource ProfSecondaryBtn}" Height="32" Margin="6,0,0,0" Click="OnBrowseRootFolderClick"/>
                                </Grid>

                                <!-- Detailed Design (TKCT) Group -->
                                <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,10" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme, ElementName=RootProfileSettingsControl}" Value="True">
                                                    <Setter Property="Background" Value="#0F172A"/>
                                                    <Setter Property="BorderBrush" Value="#334155"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc SpecProfile_TkctGroup}" FontWeight="Bold" FontSize="12" Foreground="#2563EB" Margin="0,0,0,6"/>
                                        <!-- TKCT Vi -->
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{loc:Loc SpecProfile_TkctViFolder}" FontWeight="SemiBold" FontSize="11.5"/>
                                            <TextBlock x:Name="lblTkctViStatus" Grid.Column="1" Text="{loc:Loc SpecProfile_StatusValid}" FontSize="11" Foreground="#15803D" FontWeight="Bold"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtTkctViFolder" Grid.Column="0" Style="{StaticResource ProfInputStyle}" Height="32" TextChanged="OnFolderFieldChanged"/>
                                            <Button Grid.Column="1" Content="{loc:Loc SpecProfile_BrowseBtn}" Style="{StaticResource ProfSecondaryBtn}" Height="32" Margin="6,0,0,0" Click="OnBrowseTkctViFolderClick"/>
                                        </Grid>

                                        <!-- TKCT Ja -->
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{loc:Loc SpecProfile_TkctJaFolder}" FontWeight="SemiBold" FontSize="11.5"/>
                                            <TextBlock x:Name="lblTkctJaStatus" Grid.Column="1" Text="{loc:Loc SpecProfile_StatusValid}" FontSize="11" Foreground="#15803D" FontWeight="Bold"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtTkctJaFolder" Grid.Column="0" Style="{StaticResource ProfInputStyle}" Height="32" TextChanged="OnFolderFieldChanged"/>
                                            <Button Grid.Column="1" Content="{loc:Loc SpecProfile_BrowseBtn}" Style="{StaticResource ProfSecondaryBtn}" Height="32" Margin="6,0,0,0" Click="OnBrowseTkctJaFolderClick"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Basic Design (TKCB) Group -->
                                <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,10" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme, ElementName=RootProfileSettingsControl}" Value="True">
                                                    <Setter Property="Background" Value="#0F172A"/>
                                                    <Setter Property="BorderBrush" Value="#334155"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc SpecProfile_TkcbGroup}" FontWeight="Bold" FontSize="12" Foreground="#2563EB" Margin="0,0,0,6"/>
                                        <!-- TKCB Vi -->
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{loc:Loc SpecProfile_TkcbViFolder}" FontWeight="SemiBold" FontSize="11.5"/>
                                            <TextBlock x:Name="lblTkcbViStatus" Grid.Column="1" Text="{loc:Loc SpecProfile_StatusValid}" FontSize="11" Foreground="#15803D" FontWeight="Bold"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtTkcbViFolder" Grid.Column="0" Style="{StaticResource ProfInputStyle}" Height="32" TextChanged="OnFolderFieldChanged"/>
                                            <Button Grid.Column="1" Content="{loc:Loc SpecProfile_BrowseBtn}" Style="{StaticResource ProfSecondaryBtn}" Height="32" Margin="6,0,0,0" Click="OnBrowseTkcbViFolderClick"/>
                                        </Grid>

                                        <!-- TKCB Ja -->
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{loc:Loc SpecProfile_TkcbJaFolder}" FontWeight="SemiBold" FontSize="11.5"/>
                                            <TextBlock x:Name="lblTkcbJaStatus" Grid.Column="1" Text="{loc:Loc SpecProfile_StatusValid}" FontSize="11" Foreground="#15803D" FontWeight="Bold"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtTkcbJaFolder" Grid.Column="0" Style="{StaticResource ProfInputStyle}" Height="32" TextChanged="OnFolderFieldChanged"/>
                                            <Button Grid.Column="1" Content="{loc:Loc SpecProfile_BrowseBtn}" Style="{StaticResource ProfSecondaryBtn}" Height="32" Margin="6,0,0,0" Click="OnBrowseTkcbJaFolderClick"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Test Spec Folder -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc SpecProfile_TestFolder}" FontWeight="SemiBold" FontSize="11.5"/>
                                    <TextBlock x:Name="lblTestSpecStatus" Grid.Column="1" Text="{loc:Loc SpecProfile_StatusValid}" FontSize="11" Foreground="#15803D" FontWeight="Bold"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtTestSpecFolder" Grid.Column="0" Style="{StaticResource ProfInputStyle}" Height="32" TextChanged="OnFolderFieldChanged"/>
                                    <Button Grid.Column="1" Content="{loc:Loc SpecProfile_BrowseBtn}" Style="{StaticResource ProfSecondaryBtn}" Height="32" Margin="6,0,0,0" Click="OnBrowseTestSpecFolderClick"/>
                                </Grid>

                                <!-- Search Options -->
                                <CheckBox x:Name="chkDoNotSearchSubfolders" Content="{loc:Loc SpecProfile_DoNotSearchSubfolders}" Margin="0,0,0,6"/>
                                <CheckBox x:Name="chkOpenReadOnly" Content="{loc:Loc SpecProfile_ReadOnlyDefault}" Margin="0,0,0,8"/>

                                <TextBlock Text="{loc:Loc SpecProfile_Extensions}" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,3"/>
                                <TextBox x:Name="txtFileExtensions" Style="{StaticResource ProfInputStyle}" Height="32" Margin="0,0,0,8"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- SUB-TAB 2: CƠ SỞ DỮ LIỆU ORACLE (DATABASE) -->
                    <TabItem Header="{loc:Loc SpecProfile_TabDatabase}" Style="{StaticResource SubTabItemStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,6,0">
                            <StackPanel>
                                <!-- Server Connection Group -->
                                <Border CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme, ElementName=RootProfileSettingsControl}" Value="True">
                                                    <Setter Property="Background" Value="#0F172A"/>
                                                    <Setter Property="BorderBrush" Value="#334155"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.5*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="2.5*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Host -->
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="{loc:Loc Oracle_Host}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtSettingHost" Style="{StaticResource ProfInputStyle}" Height="32"/>
                                        </StackPanel>

                                        <!-- Port -->
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="{loc:Loc Oracle_Port}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtSettingPort" Style="{StaticResource ProfInputStyle}" Height="32"/>
                                        </StackPanel>

                                        <!-- Service Name / SID -->
                                        <StackPanel Grid.Row="0" Grid.Column="4">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <RadioButton x:Name="rbSettingService" Content="{loc:Loc Oracle_ServiceName}" IsChecked="True" GroupName="DbServiceType" Margin="0,0,10,0"/>
                                                <RadioButton x:Name="rbSettingSid" Content="{loc:Loc Oracle_Sid}" GroupName="DbServiceType"/>
                                            </StackPanel>
                                            <TextBox x:Name="txtSettingService" Style="{StaticResource ProfInputStyle}" Height="32"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- User Credentials DataGrid -->
                                <Border CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme, ElementName=RootProfileSettingsControl}" Value="True">
                                                    <Setter Property="Background" Value="#0F172A"/>
                                                    <Setter Property="BorderBrush" Value="#334155"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{loc:Loc Oracle_UsersListHeader}" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="{loc:Loc Oracle_BtnAddUser}" Style="{StaticResource ProfSecondaryBtn}" Click="BtnUserAdd_Click"/>
                                        </Grid>

                                        <DataGrid x:Name="dgSettingUsers" AutoGenerateColumns="False" CanUserAddRows="False"
                                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                  MaxHeight="180" RowHeight="34" BorderThickness="1" BorderBrush="#CBD5E1"
                                                  Background="Transparent" RowHeaderWidth="0">
                                            <DataGrid.Columns>
                                                <!-- Default Selector -->
                                                <DataGridTemplateColumn Width="46">
                                                    <DataGridTemplateColumn.Header>
                                                        <TextBlock Text="⭐" ToolTip="Default User"/>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                             <RadioButton GroupName="SettingUsersDefaultGroup" IsChecked="{Binding IsDefault, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          Click="RbUserDefault_Click"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- Username -->
                                                <DataGridTemplateColumn Header="{loc:Loc Oracle_User}" Width="130">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                     Style="{StaticResource ProfInputStyle}" Height="28" Padding="6,2" Margin="2,1"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- Password -->
                                                <DataGridTemplateColumn Header="{loc:Loc Oracle_Password}" Width="130">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                     Style="{StaticResource ProfInputStyle}" Height="28" Padding="6,2" Margin="2,1"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- Role / Description -->
                                                <DataGridTemplateColumn Header="{loc:Loc Oracle_UserRole}" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding RoleOrDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                     Style="{StaticResource ProfInputStyle}" Height="28" Padding="6,2" Margin="2,1"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- Delete User -->
                                                <DataGridTemplateColumn Width="40">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="🗑️" Style="{StaticResource ProfSecondaryBtn}" 
                                                                    Padding="0" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    Click="BtnRowDeleteUser_Click"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <!-- DB Test Connection Buttons -->
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Button x:Name="btnSettingTest" Content="{loc:Loc Oracle_BtnTestConn}" Style="{StaticResource ProfSecondaryBtn}" Padding="12,5" Margin="0,0,8,4" Click="BtnSettingTest_Click"/>
                                    <Button x:Name="btnSettingTestAll" Content="{loc:Loc Oracle_BtnTestAllConn}" Style="{StaticResource ProfSecondaryBtn}" Padding="12,5" Margin="0,0,8,4" Click="BtnSettingTestAll_Click"/>
                                    <TextBlock x:Name="txtSettingDbStatus" VerticalAlignment="Center" Margin="4,0,0,4" FontSize="11" Foreground="#16A34A"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- Bottom Action Row: Save Project & Status -->
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="btnSaveProject" Content="{loc:Loc SpecProfile_BtnSave}" Style="{StaticResource ProfSuccessBtn}" Click="BtnSaveProject_Click"/>
                    <TextBlock Grid.Column="1" x:Name="txtStatusNote" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11.5" Foreground="#16A34A" TextWrapping="Wrap"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
